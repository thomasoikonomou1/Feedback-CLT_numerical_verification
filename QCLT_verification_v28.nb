Cell["Lemma 6, App. A, truncation: truncation of the noise", "Text",ExpressionUUID->"cdc106c0-a607-40ad-b1ae-ec20718da408"],

Cell[CellGroupData[{

Cell["\<\
check[\"App. A, truncation: |x| 1{|x| > A} <= |x|^3/A^2 and x^2 1{|x| > A} <= \
|x|^3/A\",
  And @@ Flatten@Table[Abs[x] Boole[Abs[x] > aa] <= Abs[x]^3/aa^2 && x^2 \
Boole[Abs[x] > aa] <= Abs[x]^3/aa, {x, -5, 5, 1/8}, {aa, 1/4, 4, 1/4}]]\
\>", "Input",
 CellLabel->"In[76]:=",ExpressionUUID->"af4998bc-18f6-43ef-bafd-f46b6772e760"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"App. A, truncation: |x| 1{|x| > A} <= |x|^3/A^2 and x^2 1{|x| > A} <= \
|x|^3/A\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653242099353*^9},
 CellLabel->"Out[76]=",ExpressionUUID->"74aa23b8-ccf1-4de7-9cd4-08c6f0791004"]
}, Open  ]],

Cell["\<\
truncOK[k_, b_, ep_] := Module[{aa = 1/(4 Sqrt[b] ep), kept, cut},
   kept = Select[atoms[k], Abs[#[[1]]] <= aa &]; cut = Select[atoms[k], \
Abs[#[[1]]] > aa &];
   N[Abs[Total[#[[1]] #[[2]] & /@ kept]]] <= N[16 b m3[k] ep^2] && 0 <= N[1 - \
Total[#[[1]]^2 #[[2]] & /@ kept]] <= N[4 Sqrt[b] m3[k] ep] &&
    N[Total[Abs[#[[1]]] #[[2]] & /@ cut]] <= N[16 b m3[k] ep^2] && \
N[Total[Abs[#[[1]]] #[[2]] & /@ kept]] <= 1 && N[Total[Abs[#[[1]]]^3 #[[2]] & \
/@ kept]] <= N[m3[k]]];\
\>", "Input",
 CellLabel->"In[77]:=",ExpressionUUID->"ac9c963d-24a1-4ac0-8c7c-d07b2619387e"],

Cell[CellGroupData[{

Cell["\<\
check[\"(A.1): the five bounds on the truncated noise (noise +1/-1 and skewed \
two-point; b = 1/10..10; eps = 1/2..1/50)\",
  And @@ Flatten@Table[truncOK[k, b, ep], {k, {\"rademacher\", \"two\"}}, {b, \
{1/10, 1/3, 1, 2, 10}}, {ep, {1/2, 1/4, 1/10, 1/50}}]]\
\>", "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"26ee318b-7cd6-4960-ab4d-02c5f011823b"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 

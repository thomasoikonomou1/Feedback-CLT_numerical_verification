}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Table I: b = -1 gives the arcsine density 1/(Pi Sqrt[c - y^2]); b = \
-1/2 gives the uniform density 1/(2L)\",
  And @@ Table[close[gb[y, -1, 2], 1/(Pi Sqrt[2 - y^2])] && close[gb[y, -1/2, \
2], 1/4], {y, {-1, 0, 1/3, 5/4}}]]\
\>", "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"361d9e82-d27c-4326-b821-490319e4676a"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Table I: b = -1 gives the arcsine density 1/(Pi Sqrt[c - y^2]); b = \
-1/2 gives the uniform density 1/(2L)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653233158091*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"30768515-3bca-4848-8546-c64e2dac7fd7"]
}, Open  ]],

Cell["\<\
varNum[b_, c_] := If[b > 0, NIntegrate[y^2 gb[y, b, c], {y, -Infinity, \
Infinity}], NIntegrate[y^2 (c + b y^2)^(-kap[b])/zz[b, c], {y, -Sqrt[-c/b], \
Sqrt[-c/b]}]];\
\>", "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"77ecf979-e55d-4e4f-8d5a-3a238320f6da"],

Cell[CellGroupData[{

Cell["\<\
check[\"Table I: the variance of g_b is c/(1-b) for b < 1 (b = 1/3, 1/2, \
-1/4, -1/2, -1)\",
  And @@ Flatten@Table[close[Quiet@varNum[b, c], c/(1 - b), 10^-4], {b, {1/3, \
1/2, -1/4, -1/2, -1}}, {c, {1, 23/10}}]]\
\>", "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"0684f69c-94d3-4a6f-8f7c-eab401c94553"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Table I: the variance of g_b is c/(1-b) for b < 1 (b = 1/3, 1/2, -1/4, \
-1/2, -1)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.0036532332394857`*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"47438c7e-75e1-4484-81d4-fc807d2d200a"]
}, Open  ]],

Cell["(II.1)-(II.4): the recursion", "Text",ExpressionUUID->"54576385-2b15-49fc-b2e4-114633757a4b"],

Cell[CellGroupData[{

Cell["\<\
check[\"(II.4): dividing (II.1) by Sqrt[n+1] gives Y_(n+1) = rho_n Y_n + \
eps_n sigma(Y_n) xi, and rho_n^2 + eps_n^2 = 1\",
  And @@ Flatten@Table[close[(s + Sqrt[c + b s^2/n] x)/Sqrt[n + 1], Sqrt[n/(n \
+ 1)] (s/Sqrt[n]) + sig[s/Sqrt[n], b, c] x/Sqrt[n + 1], 10^-12] && n/(n + 1) \
+ 1/(n + 1) == 1,
    {n, {1, 2, 7, 100}}, {s, {-3/2, 1/5, 2}}, {x, {-1, 2/3}}, {b, {-1/10, \
1/3, 2}}, {c, {1, 23/10}}]]\
\>", "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"8f75f901-5d30-4fa2-8466-fba73a184e48"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"(II.4): dividing (II.1) by Sqrt[n+1] gives Y_(n+1) = rho_n Y_n + eps_n \
sigma(Y_n) xi, and rho_n^2 + eps_n^2 = 1\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653233271047*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"7e54b5e9-452d-43fe-93f0-d4d2f67c4588"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Sec. II C: Lemma 1 (Eq. II.7) and the diffusion behind it", "Section",ExpressionUUID->"fa4cee0a-b01e-4557-8206-5ec5acdaf689"],

Cell[CellGroupData[{

Cell["\<\
check[\"(II.7), Lemma 1: (D g_b)' = -y g_b, symbolically in b, c, y\",
  Simplify[D[(c + b y^2)^(1 - kap[b]), y] + y (c + b y^2)^(-kap[b])] === 0]\
\>", "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"6d2a7b85-598b-425b-ae20-e3d107ca5496"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"(II.7), Lemma 1: (D g_b)' = -y g_b, symbolically in b, c, y\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653233276675*^9},
 CellLabel->"Out[29]=",ExpressionUUID->"2a59dc98-0191-496b-a770-6b7a2dd7caec"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Sec. II C: (II.7) implies (1/2)(D g)'' + (1/2)(y g)' = 0\",
  Simplify[D[(c + b y^2) (c + b y^2)^(-kap[b]), {y, 2}]/2 + D[y (c + b \
y^2)^(-kap[b]), y]/2] === 0]\
\>", "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"763f2639-baca-4e81-9d59-e80fe92d525e"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Sec. II C: (II.7) implies (1/2)(D g)'' + (1/2)(y g)' = 0\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.0036532333080597`*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"83128a16-5c41-4cd9-a5e2-be8ffb08f54f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Lemma 1: D g_b tends to 0 at the ends of I_b (b = 1/3, 1, 2 at \
infinity; b = -1/4, -1/2, -1 at y = L)\",
  And @@ Table[Limit[(1 + b y^2)^(-1/(2 b)), y -> Infinity] == 0, {b, {1/3, \
1, 2}}] &&
   And @@ Flatten@Table[((c + b y^2)^(-1/(2 b)) /. y -> Sqrt[-c/b]) == 0, {b, \
{-1/4, -1/2, -1}}, {c, {1, 23/10}}]]\
\>", "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"03fbe779-0b49-4461-9109-3928722e88c1"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Lemma 1: D g_b tends to 0 at the ends of I_b (b = 1/3, 1, 2 at \
infinity; b = -1/4, -1/2, -1 at y = L)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.00365323333998*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"c3621f12-5858-4d82-957f-0e2d1ff34acc"]
}, Open  ]],

Cell["\<\
Sec. II C: the diffusion behind (II.7) and the paragraph on recursions of \
stochastic-approximation type\
\>", "Text",ExpressionUUID->"f5dae432-01c0-44fc-a290-bf9375b3e487"],

Cell[CellGroupData[{

Cell["\<\
check[\"Sec. II C: (II.7) is the zero-current condition of the diffusion dU = \
-U/2 dt + sigma(U) dW: the probability current -(1/2) y g_b - (1/2)(D g_b)' \
vanishes identically\",
  Simplify[-y (c + b y^2)^(-kap[b])/2 - D[(c + b y^2) (c + b y^2)^(-kap[b]), \
y]/2] === 0]\
\>", "Input",

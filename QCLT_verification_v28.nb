Cell[CellGroupData[{

Cell["\<\
6. Appendix C 1-C 2: simulation of the recursion and Table II, with two \
additional checks (sample variance, displaced start)\
\>", "Section",ExpressionUUID->"3eb0e31b-3281-473f-b66d-4261d2059914"],

Cell["\<\
Parameters. The manuscript used mPaths = 200000 and nMax = 10000; with these \
values the eleven runs take roughly 10 to 20 minutes. For a quick run set \
mPaths = 20000 (the sampling floor is then about 0.006 instead of 0.002).\
\>", "Text",ExpressionUUID->"935c26ef-0513-408c-b5f0-606afde4dee2"],

Cell["\<\
mPaths = 200000; nMax = 10000; checkpoints = {10, 30, 100, 300, 1000, 3000, \
10000};\
\>", "Input",
 CellLabel->
  "In[102]:=",ExpressionUUID->"b780d47d-b1a4-4c00-9b33-f7d11cdee74a"],

Cell["cps = Select[checkpoints, # <= nMax &];", "Input",
 CellLabel->
  "In[103]:=",ExpressionUUID->"c5675f60-3da8-48cc-84ad-96c17e4ad6bd"],

Cell["SeedRandom[20261113];", "Input",
 CellLabel->
  "In[104]:=",ExpressionUUID->"ab018117-1cd2-4f76-b9b8-6cae57e9be54"],

Cell["\<\
The six noise laws of App. C 1, each with mean 0 and variance 1\
\>", "Text",ExpressionUUID->"32931939-beca-4b0a-a66b-f63c53bdcc30"],

Cell["noise[\"rademacher\", m_] := 2. RandomInteger[1, m] - 1.;", "Input",
 CellLabel->
  "In[105]:=",ExpressionUUID->"adf4df86-b4f6-4d01-8e1f-c702a9cc482f"],

Cell["\<\
noise[\"three\", m_] := Sqrt[2.] (RandomInteger[1, m] + RandomInteger[1, m] - \
1.);\
\>", "Input",
 CellLabel->
  "In[106]:=",ExpressionUUID->"e4bc7e5b-96ea-4937-bc59-59307a1137f2"],

Cell["\<\
noise[\"uniform\", m_] := RandomReal[{-Sqrt[3.], Sqrt[3.]}, m];\
\>", "Input",
 CellLabel->
  "In[107]:=",ExpressionUUID->"cb213d8e-be41-45a2-baba-962abfd4aa28"],

Cell["\<\
noise[\"two\", m_] := 2.5 UnitStep[RandomReal[1, m] - 0.8] - 0.5;\
\>", "Input",
 CellLabel->
  "In[108]:=",ExpressionUUID->"e10b2279-14f3-419b-b68e-5f832e98e7cd"],

Cell["\<\
noise[\"gauss\", m_] := RandomVariate[NormalDistribution[], m];\
\>", "Input",
 CellLabel->
  "In[109]:=",ExpressionUUID->"df1cab56-7311-4c34-b1f5-a967be403300"],

Cell["noise[\"exp\", m_] := -Log[RandomReal[1, m]] - 1.;", "Input",
 CellLabel->
  "In[110]:=",ExpressionUUID->"d1948bca-58ce-46f8-a808-1be47d7acbde"],

Cell[CellGroupData[{

Cell["\<\
check[\"App. C 1: the discrete noise laws have mean 0 and variance 1; E|xi|^3 \
= 1 (+1/-1) and 17/10 (skewed two-point)\",
  And @@ Table[Total[#[[1]] #[[2]] & /@ atoms[k]] == 0 && Total[#[[1]]^2 \
#[[2]] & /@ atoms[k]] == 1, {k, {\"rademacher\", \"two\", \"three\"}}] &&
   Total[Abs[#[[1]]]^3 #[[2]] & /@ atoms[\"rademacher\"]] == \
m3[\"rademacher\"] && Total[Abs[#[[1]]]^3 #[[2]] & /@ atoms[\"two\"]] == \
m3[\"two\"]]\
\>", "Input",
 CellLabel->
  "In[111]:=",ExpressionUUID->"cb5e8b00-b445-4de7-a212-e06e112d9bba"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"App. C 1: the discrete noise laws have mean 0 and variance 1; E|xi|^3 = \
1 (+1/-1) and 17/10 (skewed two-point)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653245663121*^9},
 CellLabel->
  "Out[111]=",ExpressionUUID->"4da82b7d-8abd-4f7c-a44f-18cd6c8a3f31"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"App. C 1: the uniform, Gaussian and centred exponential laws have \
mean 0 and variance 1; E|xi|^3 = 2 Sqrt[2/Pi] (Gaussian) and 12/E - 2 \
(centred exponential)\",
  Integrate[x/(2 Sqrt[3]), {x, -Sqrt[3], Sqrt[3]}] == 0 && Integrate[x^2/(2 \
Sqrt[3]), {x, -Sqrt[3], Sqrt[3]}] == 1 && Mean[NormalDistribution[]] == 0 && \
Variance[NormalDistribution[]] == 1 &&
   Integrate[(x - 1) Exp[-x], {x, 0, Infinity}] == 0 && Integrate[(x - 1)^2 \
Exp[-x], {x, 0, Infinity}] == 1 && close[2 Integrate[x^3 \
PDF[NormalDistribution[], x], {x, 0, Infinity}], m3[\"gauss\"], 10^-12] &&
   close[Integrate[(1 - x)^3 Exp[-x], {x, 0, 1}] + Integrate[(x - 1)^3 \
Exp[-x], {x, 1, Infinity}], m3[\"exp\"], 10^-12]]\
\>", "Input",
 CellLabel->
  "In[112]:=",ExpressionUUID->"596f45bf-25a6-43ca-85a0-9a18869bccf3"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"App. C 1: the uniform, Gaussian and centred exponential laws have mean \
0 and variance 1; E|xi|^3 = 2 Sqrt[2/Pi] (Gaussian) and 12/E - 2 (centred \
exponential)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653247205346*^9},
 CellLabel->
  "Out[112]=",ExpressionUUID->"91bbd975-abd8-4503-91d6-97f86a3701a4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"App. C 1: the sampled noise has mean 0 and variance 1 within sampling \
error (10^6 draws each)\",
  And @@ Table[With[{v = noise[k, 1000000]}, Abs[Mean[v]] < 0.005 && \
Abs[Mean[v^2] - 1] < 0.02], {k, {\"rademacher\", \"three\", \"uniform\", \
\"two\", \"gauss\", \"exp\"}}]]\
\>", "Input",
 CellLabel->
  "In[113]:=",ExpressionUUID->"6d23e46b-a3c8-4315-8d57-dacf645e691c"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"App. C 1: the sampled noise has mean 0 and variance 1 within sampling \
error (10^6 draws each)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653247350115*^9},
 CellLabel->
  "Out[113]=",ExpressionUUID->"1e84f44f-3972-4d0f-9a6c-7fa517002513"]
}, Open  ]],

Cell["\<\
Distribution function, quantile function and sampler of g_b for c = 1, \
written with the regularized incomplete Beta function so that they act on \
whole lists\
\>", "Text",ExpressionUUID->"1de58558-7f0f-422a-9817-1f81cd755992"],

Cell["\<\
cdfG[b_, y_] := Which[b > 0, With[{nu = 1. + 1/b}, 0.5 + Sign[y] (1 - \
BetaRegularized[nu/(nu + (1 + b) y^2), nu/2, 0.5])/2],
   b == 0, (1. + Erf[y/Sqrt[2.]])/2,
   True, With[{al = -1./(2 b)}, BetaRegularized[(Clip[y Sqrt[-b], {-1., 1.}] \
+ 1)/2, al, al]]];\
\>", "Input",
 CellLabel->
  "In[114]:=",ExpressionUUID->"ba2f0b76-89dc-45a8-aaf6-20884482a21c"],

Cell["\<\
quantG[b_, p_?NumericQ] := With[{nu = 1. + 1/b, x = InverseBetaRegularized[2 \
(0.5 - Abs[p - 0.5]), (1. + 1/b)/2, 0.5]}, Sign[p - 0.5] Sqrt[nu (1 - \
x)/x]/Sqrt[1. + b]];\
\>", "Input",
 CellLabel->
  "In[115]:=",ExpressionUUID->"e2484670-461e-4c6d-a5b9-389776567226"],

Cell["quantG[b_, p_List] := quantG[b, #] & /@ p;", "Input",
 CellLabel->
  "In[116]:=",ExpressionUUID->"f1d6f42e-d412-4951-9999-d701fbaae5ff"],

Cell["\<\
sampleG[b_, m_] := If[b > 0, RandomVariate[StudentTDistribution[1 + 1/b], \
m]/Sqrt[1. + b], (2 RandomVariate[BetaDistribution[-1/(2 b), -1/(2 b)], m] - \
1)/Sqrt[-1. b]];\
\>", "Input",
 CellLabel->
  "In[117]:=",ExpressionUUID->"f144d7fc-8bed-49c8-acd5-24ed78c28836"],

Cell[CellGroupData[{

Cell["\<\
check[\"App. C 1: the distribution function used for the Kolmogorov distance \
agrees with the built-in Student and Beta distribution functions\",
  And @@ Flatten@Table[close[cdfG[b, N[y]], If[b > 0, \
CDF[StudentTDistribution[0, Sqrt[1/(1 + b)], 1 + 1/b], y], \
CDF[BetaDistribution[-1/(2 b), -1/(2 b)], (y Sqrt[-b] + 1)/2]], 10^-10],
    {b, {-1, -1/2, -1/4, 1/3, 1, 2}}, {y, {-9/10, -1/3, 0, 1/7, 4/5}}]]\
\>", "Input",
 CellLabel->
  "In[118]:=",ExpressionUUID->"e3f7b5c7-0a64-49e4-b3b2-db68f1a7cd04"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"App. C 1: the distribution function used for the Kolmogorov distance \
agrees with the built-in Student and Beta distribution functions\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.0036532474244337`*^9},
 CellLabel->
  "Out[118]=",ExpressionUUID->"263b9820-13cb-46df-ba34-a55d27a934e8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"App. C 1: the quantile function inverts the distribution function (b \
= 1/3, 1, 2)\",
  And @@ Flatten@Table[close[cdfG[b, quantG[b, p]], p, 10^-9], {b, {1/3, 1, \
2}}, {p, {0.001, 0.2, 0.5, 0.7, 0.9999}}]]\
\>", "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"609a5e7f-cab5-4013-9e5c-5884fdebbf99"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"App. C 1: the quantile function inverts the distribution function (b = \
1/3, 1, 2)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.0036532474302263`*^9},
 CellLabel->
  "Out[119]=",ExpressionUUID->"2b541ad6-3dd3-42ad-8b19-d15a8596c6ff"]
}, Open  ]],

Cell["\<\
ksDist[y_, b_] := With[{f = cdfG[b, Sort[y]], m = Length[y]}, \
Max[Max[Range[m]/N[m] - f], Max[f - (Range[m] - 1)/N[m]]]];\
\>", "Input",
 CellLabel->
  "In[120]:=",ExpressionUUID->"fcd856f4-c4f7-4f22-b89d-d7009817d159"],

Cell["\<\
floorKS[b_, m_] := Mean[Table[ksDist[sampleG[b, m], b], {5}]];\
\>", "Input",
 CellLabel->
  "In[121]:=",ExpressionUUID->"909fad25-4c99-4495-9d28-47675e3f8241"],

Cell["\<\
The recursion (II.1) with c = 1, for m paths at once. The Clip is the \
rounding guard of App. C 1\
\>", "Text",ExpressionUUID->"be1a483c-7af6-4dca-838a-62ae2580de7f"],

Cell["\<\
simulate[b_, kind_, start_, m_, nmax_, wantW1_ : False] := Module[{s, bb = \
N[b], ks = {}, vr = {}, w1 = {}, qv, y},
   s = If[start === None, noise[kind, m], ConstantArray[N[start], m]];
   If[wantW1, qv = quantG[b, (Range[m] - 0.5)/m]];
   Do[
    s = s + Sqrt[Clip[1. + bb s^2/n, {0., Infinity}]] noise[kind, m];
    If[MemberQ[cps, n + 1],
     y = s/Sqrt[n + 1.];
     AppendTo[ks, ksDist[y, b]]; AppendTo[vr, Mean[y^2]];
     If[wantW1, AppendTo[w1, Mean[Abs[Sort[y] - qv]]]]],
    {n, 1, nmax - 1}];
   <|\"ks\" -> ks, \"var\" -> vr, \"w1\" -> w1, \"final\" -> \
s/Sqrt[N[nmax]]|>];\
\>", "Input",
 CellLabel->
  "In[122]:=",ExpressionUUID->"86a6d5dc-2d0e-4473-aade-822ee5639dfd"],

Cell["\<\
cases = {{-1, \"rademacher\"}, {-1/2, \"three\"}, {-1/2, \"rademacher\"}, \
{-1/4, \"uniform\"}, {-1/4, \"two\"}, {1/3, \"gauss\"}, {1/3, \"exp\"}, {1, \
\"gauss\"}, {1, \"exp\"}, {2, \"gauss\"}, {2, \"rademacher\"}};\
\>", "Input",
 CellLabel->
  "In[123]:=",ExpressionUUID->"c2b725a3-9c3c-4fc0-89a2-3e85c6310f74"],

Cell[CellGroupData[{

Cell["\<\
simTime = First@AbsoluteTiming[Do[sims[cs] = simulate[cs[[1]], cs[[2]], None, \
mPaths, nMax], {cs, cases}]]\
\>", "Input",
 CellLabel->
  "In[124]:=",ExpressionUUID->"b1ee276d-1388-4952-b9a5-d1f299f0760f"],

Cell[BoxData["282.903806`"], "Output",
 CellChangeTimes->{4.003653530359763*^9},
 CellLabel->
  "Out[124]=",ExpressionUUID->"212362c7-9e6f-48bd-9672-0dbd566701aa"]
}, Open  ]],

Cell["\<\
floors = Association[Table[b -> floorKS[b, mPaths], {b, {-1, -1/2, -1/4, 1/3, \
1, 2}}]];\
\>", "Input",
 CellLabel->
  "In[125]:=",ExpressionUUID->"e8312f34-51ab-440c-bce8-21d088c4b2fc"],

Cell["Table II: Kolmogorov distance to g_b", "Text",ExpressionUUID->"6888d568-4600-4689-b99c-cc67da83b495"],

Cell[CellGroupData[{

Cell["\<\
table1 = Grid[Prepend[Table[Join[{cs[[1]], cs[[2]]}, NumberForm[#, {5, 4}] & \
/@ sims[cs][\"ks\"], {NumberForm[floors[cs[[1]]], {5, 4}]}], {cs, cases}], \
Join[{\"b\", \"noise\"}, (\"N = \" <> ToString[#]) & /@ cps, {\"floor\"}]], \
Frame -> All, Background -> {None, {1 -> LightGray}}]\
\>", "Input",
 CellLabel->
  "In[126]:=",ExpressionUUID->"7ecf5b76-a726-42c7-80a1-255f9b1c9bba"],


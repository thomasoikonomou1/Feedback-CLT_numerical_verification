       GridBoxItemSize->{"Columns" -> {Automatic, 60, Automatic}},
       GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.6}}}],
      "Grid"]}
   },
   DefaultBaseStyle->"Column",

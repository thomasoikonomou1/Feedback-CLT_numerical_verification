Cell[CellGroupData[{

Cell["\<\
8. Lemma 6: additional numerical check of the one-step defect (additional \
tables and figure)\
\>", "Section",ExpressionUUID->"40336391-3a75-4c28-9d44-4f452e6736c9"],

Cell["\<\
Lemma 6 (additional numerical check): the one-step defect W1(g K^eps, g) by \
numerical integration, c = 1. half[b, x] = P(Y > |x|). The absolute \
difference of the two distribution functions is integrated with the \
trapezoidal rule after the substitution x = Sinh[u], on 20001 points of -45 \
<= u <= 45 (the method of the Python scripts). Survival functions are \
compared for x >= 0 and distribution functions for x < 0, which keeps the \
relative precision in both tails. The arithmetic is exact in b, eps and the \
noise values and uses 30 digits on the grid: at machine precision the \
incomplete Beta function is not accurate enough for the smallest values \
(about 10^-10), which spoiled the fitted powers for b = 1. The table takes \
about two minutes\
\>", "Text",ExpressionUUID->"98a1a22b-b90f-4b86-b7c9-69a9eabe74be"],

Cell["\<\
half[b_, x_] := BetaRegularized[(1 + 1/b)/((1 + 1/b) + (1 + b) x^2), (1 + \
1/b)/2, 1/2]/2;\
\>", "Input",
 CellLabel->
  "In[162]:=",ExpressionUUID->"990e1d89-4019-4950-948f-bb3fdc038e4b"],

Cell["upperG[b_, y_] := If[y >= 0, half[b, y], 1 - half[b, y]];", "Input",
 CellLabel->
  "In[163]:=",ExpressionUUID->"138b1abf-b178-4d4c-a89c-6b2d0ebac269"],

Cell["lowerG[b_, y_] := If[y < 0, half[b, y], 1 - half[b, y]];", "Input",
 CellLabel->
  "In[164]:=",ExpressionUUID->"ca495114-4def-494b-ad83-3dc03da6a8c4"],

Cell["\<\
tInv[b_, rho_, e_, x_] := (rho x - e Sqrt[b x^2 + rho^2 - e^2 b])/(rho^2 - \
e^2 b);\
\>", "Input",
 CellLabel->
  "In[165]:=",ExpressionUUID->"a8c6a4a9-c151-4f41-83ed-d2785aa3620d"],

Cell[CellGroupData[{

Cell["\<\
check[\"Lemma 6 (additional numerical check): the explicit inverse of \
Psi_i(y) = rho y + e sigma(y), c = 1\",
  And @@ Flatten@Table[With[{rho = Sqrt[1 - ep^2], e = ep xi}, close[tInv[b, \
rho, e, rho y + e sig[y, b, 1]], y, 10^-10]], {b, {1/3, 1, 2}}, {ep, {1/5, \
1/40}}, {xi, {2, -1/2, 1, -1}}, {y, {-30, -2, 0, 1/3, 7}}]]\
\>", "Input",
 CellLabel->
  "In[166]:=",ExpressionUUID->"f5ea2dbf-79c0-4c11-8e66-190b93da19f6"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Lemma 6 (additional numerical check): the explicit inverse of Psi_i(y) \
= rho y + e sigma(y), c = 1\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.0036536427786093`*^9},
 CellLabel->
  "Out[166]=",ExpressionUUID->"c8a19d3f-83d5-480e-8c6b-9898a6a9d606"]
}, Open  ]],

Cell["\<\
defectIntegrand[b_, ep_, at_, x_?NumericQ] := With[{rho = Sqrt[1 - ep^2]},
   Abs[Sum[a[[2]] If[x >= 0, upperG[b, tInv[b, rho, ep a[[1]], x]], lowerG[b, \
tInv[b, rho, ep a[[1]], x]]], {a, at}] - half[b, x]]];\
\>", "Input",
 CellLabel->
  "In[167]:=",ExpressionUUID->"3d66b151-5bc4-4fe3-b3ac-3a4d32ae93b4"],

Cell["\<\
defect[b_, ep_, at_] := Module[{np = 20000, ug, xg, rho = Sqrt[1 - ep^2], st, \
mix, yy, hh, sy},
   ug = N[-45 + 90 Range[0, np]/np, 30]; xg = Sinh[ug]; st = UnitStep[xg]; \
mix = 0 xg;
   Do[yy = tInv[b, rho, ep a[[1]], xg]; hh = half[b, yy]; sy = UnitStep[yy];
    mix += a[[2]] (st (sy hh + (1 - sy) (1 - hh)) + (1 - st) ((1 - sy) hh + \
sy (1 - hh))), {a, at}];
   N[(90/np) Total[Abs[mix - half[b, xg]] Cosh[ug]]]];\
\>", "Input",
 CellLabel->
  "In[168]:=",ExpressionUUID->"c373dfcc-c0f0-4490-b398-0fa5ae7d1952"],

Cell["\<\
defectNI[b_, ep_, at_] := Quiet@NIntegrate[defectIntegrand[b, ep, at, \
Sinh[u]] Cosh[u], {u, -45, 0, 45}, MaxRecursion -> 30, PrecisionGoal -> 5, \
Method -> \"GlobalAdaptive\"];\
\>", "Input",
 CellLabel->
  "In[169]:=",ExpressionUUID->"1cef205d-0cf1-4c32-8f36-2f06503f82af"],

Cell[CellGroupData[{

Cell["\<\
check[\"Lemma 6 (additional numerical check): the trapezoidal value of W1(g \
K^eps, g) agrees with adaptive integration (NIntegrate) within 1% (b = 1/3, \
skewed noise, eps = 1/10; b = 2, noise +1/-1, eps = 1/10)\",
  Abs[defect[1/3, 1/10, atoms[\"two\"]]/defectNI[1/3., 0.1, \
N[atoms[\"two\"]]] - 1] < 0.01 && Abs[defect[2, 1/10, \
atoms[\"rademacher\"]]/defectNI[2., 0.1, N[atoms[\"rademacher\"]]] - 1] < \
0.01]\
\>", "Input",
 CellLabel->
  "In[170]:=",ExpressionUUID->"4c66bb6b-f677-4d9e-80bd-e04146230bf5"],

Cell[BoxData[
 TemplateBox[{
  "N", "meprec", 

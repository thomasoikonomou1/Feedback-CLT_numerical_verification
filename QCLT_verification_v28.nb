Cell[CellGroupData[{

Cell["\<\
check[\"Sec. II C: rho_n = 1 - 1/(2(n+1)) + O(n^-2), since n^2 (rho_n - 1 + \
1/(2(n+1))) -> -1/8\",
  Limit[n^2 (Sqrt[n/(n + 1)] - 1 + 1/(2 (n + 1))), n -> Infinity] == -1/8]\

standard errors (martingale property)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653556548914*^9},
 CellLabel->
  "Out[136]=",ExpressionUUID->"cde17268-e36b-401f-9c2c-b002601f441a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Theorem B, size of the bound (additional check): the second term of \
(II.5), Lambda C_L ln(N/3)/Sqrt[N], is about 36 at N = 10^4 (b = 1/3, noise \
+1/-1), far above the measured distance\",
  close[lamOf[1/3, 1] clOf[1/3, 1, 1] Log[10^4/3]/100, 35.845, 10^-4] && \
lamOf[1/3, 1] clOf[1/3, 1, 1] Log[nMax/3]/Sqrt[nMax] > Last[simD[\"w1\"]]]\
\>", "Input",
 CellLabel->
  "In[137]:=",ExpressionUUID->"2db4b4b7-56e2-49cf-b446-6a5036040b8c"],


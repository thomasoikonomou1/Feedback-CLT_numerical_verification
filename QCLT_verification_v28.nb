 CellLabel->"Out[69]=",ExpressionUUID->"3802cde8-6e25-4f0f-aff2-dac21ea2b118"]
}, Open  ]],

Cell["\<\
absMean[\"rademacher\"][rho_, e_] := (Abs[rho + e] + Abs[rho - e])/2;\
\>", "Input",
 CellLabel->"In[70]:=",ExpressionUUID->"1478e666-517a-42e0-b4f5-72a7d77c4a1a"],

Cell["\<\
absMean[\"two\"][rho_, e_] := Abs[rho + 2 e]/5 + 4 Abs[rho - e/2]/5;\
\>", "Input",
 CellLabel->"In[71]:=",ExpressionUUID->"66bffc4d-d9e2-499a-b57d-3de8ee865496"],

Cell["\<\
absMean[\"gauss\"][rho_, e_] := If[e == 0 || rho > 30 Abs[e], rho, Abs[e] \
Sqrt[2/Pi] Exp[-rho^2/(2 e^2)] + rho Erf[rho/(Abs[e] Sqrt[2])]];\
\>", "Input",
 CellLabel->"In[72]:=",ExpressionUUID->"e55021f2-1979-4da6-a5cb-7cc22e19fcc8"],

Cell[CellGroupData[{

Cell["\<\
check[\"Lemma 5, proof (one step): E|rho_n + eps_n theta xi| <= rho_n (1 + \
delta_n), delta_n = 4 Sqrt[2] b^(3/2) M3 (n+1)^(-3/2) (three noise laws; b = \
1/3, 1, 2, 10; n = 1..60)\",
  And @@ Flatten@Table[With[{rho = Sqrt[n/(n + 1)], ep = 1/Sqrt[n + 1]}, \
N[absMean[k][rho, ep th Sqrt[b]]] <= N[rho (1 + 4 Sqrt[2] b^(3/2) m3[k] (n + \
1)^(-3/2))] + 10^-12],
    {k, {\"rademacher\", \"two\", \"gauss\"}}, {b, {1/3, 1, 2, 10}}, {n, 1, \
60}, {th, -1, 1, 1/8}]]\
\>", "Input",
 CellLabel->"In[73]:=",ExpressionUUID->"36f8bb71-0685-49ce-a0e8-83b3c2f13b57"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 

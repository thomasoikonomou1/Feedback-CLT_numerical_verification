Cell[CellGroupData[{

Cell["\<\
check[\"Additional table (sample variance): for b < 0 the sample variance at \
the largest N equals c/(1-b) within five standard errors\",
  And @@ Table[With[{be = -cs[[1]]}, Abs[Last[sims[cs][\"var\"]] - 1/(1 + \
be)] < 5 Sqrt[(mLim[4, be, 1] - mLim[2, be, 1]^2)/mPaths] + 0.002], {cs, \
Select[cases, #[[1]] < 0 &]}]]\
\>", "Input",
 CellLabel->
  "In[131]:=",ExpressionUUID->"8fd9f86e-2610-4c4c-8268-c1bf00075242"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Additional table (sample variance): for b < 0 the sample variance at \
the largest N equals c/(1-b) within five standard errors\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653540255624*^9},
 CellLabel->
  "Out[131]=",ExpressionUUID->"ef196aca-2796-46c5-8cbd-1d5d1903d129"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Additional table (sample variance): for b = 1/3 the sample variance \
at the largest N is within 10% of c/(1-b) = 3/2 (the fourth moment is \
infinite, so no standard error is used)\",
  And @@ Table[Abs[Last[sims[cs][\"var\"]]/1.5 - 1] < 0.1, {cs, {{1/3, \
\"gauss\"}, {1/3, \"exp\"}}}]]\
\>", "Input",
 CellLabel->
  "In[132]:=",ExpressionUUID->"734e079f-a844-4c36-8773-10ad13c8e32b"],


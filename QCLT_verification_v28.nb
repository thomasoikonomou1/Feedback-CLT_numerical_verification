Cell[CellGroupData[{

Cell["\<\
tailDev = Max[Flatten[MapThread[Function[{cs, dat}, (Abs[#[[2]] - \
tailExact[cs[[1]], #[[1]]]] - 0.03 tailExact[cs[[1]], \
#[[1]]])/Sqrt[tailExact[cs[[1]], #[[1]]]/mPaths] & /@ dat], {tailCases, \
tailData}]]]\
\>", "Input",
 CellLabel->
  "In[158]:=",ExpressionUUID->"a09add5c-c188-48c9-8159-0e036adab7b7"],

Cell[BoxData["2.4235140373034945`"], "Output",
 CellChangeTimes->{4.0036536424678926`*^9},
 CellLabel->
  "Out[158]=",ExpressionUUID->"f1a815df-19af-467b-8c4d-ce4a4e49bccc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Fig. 2: the simulated tail probabilities agree with the exact tails, \
which decay like x^-(1+1/b), within five standard errors plus 3%\", tailDev < \
5]\
\>", "Input",
 CellLabel->
  "In[159]:=",ExpressionUUID->"c0051812-5332-4ebc-9f1c-535e06a24daf"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Fig. 2: the simulated tail probabilities agree with the exact tails, \
which decay like x^-(1+1/b), within five standard errors plus 3%\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653642476748*^9},
 CellLabel->
  "Out[159]=",ExpressionUUID->"f406ac2a-a922-42ba-a354-c389ac5cdf41"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Fig. 2: the exact tails have the exponents 4, 2 and 3/2 (local slope \
at x = 10^4)\",
  And @@ MapThread[Abs[(Log[tailExact[#1, 2. 10^4]] - Log[tailExact[#1, \
10.^4]])/Log[2.] + #2] < 0.01 &, {{1/3, 1, 2}, {4, 2, 3/2}}]]\
\>", "Input",
 CellLabel->
  "In[160]:=",ExpressionUUID->"57a482a7-0177-48fc-8d55-dc73430a777c"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Fig. 2: the exact tails have the exponents 4, 2 and 3/2 (local slope at \
x = 10^4)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653642482417*^9},
 CellLabel->
  "Out[160]=",ExpressionUUID->"d3ba3e0b-e63f-4266-a6c0-9b0af64c0a40"]
}, Open  ]],

Cell["\<\
Additional figure (displaced start): the starting value S_1 = 4 is forgotten \
at the rate N^(-1/2)\
\>", "Text",ExpressionUUID->"e2fd027b-7ffa-4fff-b2f4-664ae7ca6aed"],

Cell[CellGroupData[{

Cell["\<\
fig3 = Show[ListLogLogPlot[Transpose[{cps, simD[\"w1\"]}], PlotStyle -> colB, \
PlotMarkers -> {Automatic, 8}, PlotRange -> {{8, 12000}, {0.02, 2}}, \
PlotLegends -> Placed[{\"simulation\"}, {0.75, 0.88}]],
   LogLogPlot[4/Sqrt[x], {x, 10, 10000}, PlotStyle -> colO, PlotRange -> {{8, \
12000}, {0.02, 2}}, PlotLegends -> Placed[{\"4/Sqrt[N] (lower bound)\"}, \
{0.75, 0.78}]],
   Frame -> True, Axes -> False, FrameLabel -> {\"N\", \"W1 distance to g\"}, \
ImageSize -> 440]\
\>", "Input",
 CellLabel->
  "In[161]:=",ExpressionUUID->"b120a4c2-5404-4d2a-84e3-ef2d13518ff4"],


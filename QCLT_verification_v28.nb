Cell["Lemma 6, App. A, the maps Psi: the maps Psi", "Text",ExpressionUUID->"00d6f0c4-a862-4d38-b75d-31910c130b12"],

Cell[CellGroupData[{

Cell["\<\
check[\"App. A, the maps Psi: |Psi(y)| >= |y|/2 - Sqrt[c]/(4 Sqrt[b]) for |s| \
<= s0 = 1/(4 Sqrt[b]) and 0 <= t <= 1/2\",
  And @@ Flatten@Table[N[Abs[Sqrt[1 - t^2] y + u/(4 Sqrt[b]) sig[y, b, c]]] \
>= N[Abs[y]/2 - Sqrt[c]/(4 Sqrt[b])] - 10^-12,
    {b, {1/10, 1/3, 1, 2, 10}}, {c, {1/2, 1, 5}}, {t, {0, 1/4, 1/2}}, {u, \
{-1, -1/2, 0, 1/2, 1}}, {y, -50, 50, 5/4}]]\
\>", "Input",
 CellLabel->"In[80]:=",ExpressionUUID->"137aa870-2d64-411e-bd10-9181c708e2bb"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"App. A, the maps Psi: |Psi(y)| >= |y|/2 - Sqrt[c]/(4 Sqrt[b]) for |s| \
<= s0 = 1/(4 Sqrt[b]) and 0 <= t <= 1/2\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653243613031*^9},
 CellLabel->"Out[80]=",ExpressionUUID->"35dca63a-5964-47fe-b498-f70cf7eb4b76"]
}, Open  ]],

Cell["\<\
Lemma 6, App. A: the formulas (A.6)-(A.9) and the bounds (A.10), for the \
concrete test function h'(x) = Tanh[3 Sin[x]] Exp[-x^2/50], which is smooth \
with |h'| <= 1\
\>", "Text",ExpressionUUID->"2d0619c4-0781-43bb-8e1f-0d6cf27162cd"],

Cell["hp[x_] := Tanh[3 Sin[x]] Exp[-x^2/50];", "Input",
 CellLabel->"In[81]:=",ExpressionUUID->"61da3f2b-34ac-4b76-9067-fae2b36672de"],

Cell["hpp[x_] = D[Tanh[3 Sin[x]] Exp[-x^2/50], x];", "Input",
 CellLabel->"In[82]:=",ExpressionUUID->"2f695e63-7ed5-464b-b9a6-276908d194cb"],

Cell["\<\
abData[b_, c_, t_] := Module[{rho = Sqrt[1 - t^2], a = 1/(4 Sqrt[b]), g, sg, \
tT, tau, pp, uu, int, aF, bF, a1F, a2F, b1F, d = 0.001, pts},
   g = (c + b yv^2)^(-kap[b])/zz[b, c]; sg = Sqrt[c + b yv^2]; tT = rho yv + \
sv sg; tau = D[tT, yv]; pp = sg^2 g; uu = D[pp/tau, yv];
   int[e_] := Quiet@NIntegrate[e, {yv, -Infinity, Infinity}, MaxRecursion -> \
40, PrecisionGoal -> 9, AccuracyGoal -> 10, Method -> {\"GlobalAdaptive\", \
\"SymbolicProcessing\" -> 0}];
   aF[s0_] := int[hp[tT] sg g /. sv -> s0]; bF[s0_] := int[hp[tT] yv g /. sv \
-> s0];
   a1F[s0_] := -int[hp[tT] uu /. sv -> s0];
   a2F[s0_] := int[hp[tT] (D[sg uu/tau, yv] + D[pp D[sg, yv]/tau^2, yv]) /. \
sv -> s0];
   b1F[s0_] := -int[hp[tT] D[sg yv g/tau, yv] /. sv -> s0];
   pts = {-a/2, 0., a/2};
   <|\"(A.6) A' = -Int h'(Psi) U\" -> And @@ Table[close[a1F[s0], int[hpp[tT] \
sg^2 g /. sv -> s0], 10^-6], {s0, pts}],
    \"(A.7) A''\" -> And @@ Table[close[a2F[s0], (a1F[s0 + d] - a1F[s0 - \
d])/(2 d), 10^-4], {s0, pts}],
    \"(A.8) B'\" -> And @@ Table[close[b1F[s0], int[hpp[tT] sg yv g /. sv -> \
s0], 10^-6], {s0, pts}],
    \"(A.9) A'(0) = B(0)/rho\" -> close[a1F[0.], bF[0.]/rho, 10^-6],
    \"(A.10) bounds\" -> (And @@ Table[Abs[a2F[s0]] <= (22 + 19 b + 4/b) \
a1Of[b, c] && Abs[b1F[s0]] <= (7 + 2/b) a1Of[b, c], {s0, pts}] && Abs[aF[0.]] \
<= a1Of[b, c] && Abs[bF[0.]] <= a1Of[b, c]/Sqrt[b])|>];\
\>", "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"8e1eecda-2bb0-4c01-a23c-44a5198a4d69"],

Cell[CellGroupData[{

Cell["abResults = {abData[1/3., 1., 0.2], abData[2., 1., 0.4]}", "Input",
 CellLabel->"In[84]:=",ExpressionUUID->"6a672466-b7e3-4a39-8c73-b13b16b4b8c7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"(A.6) A' = -Int h'(Psi) U\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"(A.7) A''\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"(A.8) B'\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"(A.9) A'(0) = B(0)/rho\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"(A.10) bounds\"\>", "\[Rule]", "True"}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"(A.6) A' = -Int h'(Psi) U\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"(A.7) A''\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"(A.8) B'\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"(A.9) A'(0) = B(0)/rho\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"(A.10) bounds\"\>", "\[Rule]", "True"}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellChangeTimes->{4.003653244073894*^9},
 CellLabel->"Out[84]=",ExpressionUUID->"1b27c81d-4c6a-4d23-ab4f-ba05380a27ad"]
}, Open  ]],


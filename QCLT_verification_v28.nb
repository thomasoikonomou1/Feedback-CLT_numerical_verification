 CellLabel->
  "Out[142]=",ExpressionUUID->"99340075-93da-49af-8c43-365906832f18"]
}, Open  ]],

Cell["\<\
pdfG[b_, y_] := If[b == 0, PDF[NormalDistribution[], y], gb[y, b, 1]];\
\>", "Input",
 CellLabel->
  "In[143]:=",ExpressionUUID->"56712c4c-0048-400d-a2bc-6e440d354cb1"],

Cell["\<\
range1[b_] := Which[b > 0, {-6., 6.}, b == 0, {-4., 4.}, True, {-1., \
1.}/Sqrt[-1. b]];\
\>", "Input",
 CellLabel->
  "In[144]:=",ExpressionUUID->"cf5e8638-8d88-440f-87d5-96bf53e1bb36"],

Cell["\<\
panel[b_, kind_, title_] := Module[{yN = sims[{b, kind}][\"final\"], lo, hi, \
nb, edges, cnt, mid, hts, ymax},
   {lo, hi} = range1[b]; nb = If[b >= 0, 60, 40];
   edges = lo + (hi - lo) Range[0, nb]/nb; cnt = BinCounts[yN, {edges}];
   mid = (Most[edges] + Rest[edges])/2; hts = cnt/(Length[yN] (hi - lo)/nb); \
ymax = 1.3 Max[hts];
   Show[Plot[pdfG[b, y], {y, lo, hi}, PlotStyle -> Directive[colO, \
Thickness[0.007]], PlotRange -> {{lo, hi}, {0, ymax}}, PlotPoints -> 200],
    ListPlot[Transpose[{mid, hts}], PlotStyle -> Directive[colB, \
PointSize[0.02]]],
    Frame -> True, Axes -> False, PlotRange -> {{lo, hi}, {0, ymax}}, \
PlotLabel -> Style[title, 10], FrameLabel -> {\"y\", None}, ImageSize -> \
230]];\
\>", "Input",
 CellLabel->
  "In[145]:=",ExpressionUUID->"d693c907-f19f-4ff3-9d50-f191f11d721a"],

Cell["\<\
fig1Panels = {panel[-1, \"rademacher\", \"no q (b = -1)\\narcsine law, noise \
\[PlusMinus]1\"], panel[-1/2, \"three\", \"q -> -Infinity (b = \
-1/2)\\nuniform law, three-point noise\"],
   panel[-1/3, \"three\", \"q = -1 (b = -1/3)\\nsemicircle law, three-point \
noise\"], panel[-1/4, \"two\", \"q = 0 (b = -1/4)\\nparabola, skewed \
two-point noise\"],
   panel[-1/6, \"uniform\", \"q = 1/2 (b = -1/6)\\ncompact support, uniform \
noise\"], panel[0, \"exp\", \"q = 1 (b = 0)\\nGaussian, centred exponential \
noise\"],
   panel[1/3, \"exp\", \"q = 7/5 (b = 1/3)\\nfinite variance, centred exp. \
noise\"], panel[1, \"gauss\", \"q = 5/3 (b = 1)\\ninfinite variance, Gaussian \
noise\"],
   panel[2, \"rademacher\", \"q = 9/5 (b = 2)\\ninfinite variance, noise \
\[PlusMinus]1\"]};\
\>", "Input",
 CellLabel->
  "In[146]:=",ExpressionUUID->"5e6b652c-9b69-43e3-b792-88c8b6f4b077"],

Cell[CellGroupData[{

Cell["fig1 = Grid[Partition[fig1Panels, 5, 5, {1, 1}, {}]]", "Input",
 CellLabel->
  "In[147]:=",ExpressionUUID->"e498719d-c949-4991-812c-68926a898262"],


Cell["\<\
slopeOf[r_] := Fit[Log[N[Transpose[{r[\"eps\"], r[\"w1\"]}]]], {1, zfit}, \
zfit][[2, 1]];\
\>", "Input",
 CellLabel->
  "In[173]:=",ExpressionUUID->"f15348b1-b879-43e2-aebb-5eb5b8fea346"],

Cell["\<\
Additional table (one-step defect): fitted power of eps, the ratio W1/eps^3 \
at the smallest eps, a_1 and C_L\

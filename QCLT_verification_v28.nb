}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Remark after Prop. C: the variance is finite (tail exponent > 3) \
exactly when b < 1\",
  Resolve[ForAll[b, 0 < b < 1, 2 + 1/b > 3], Reals] && Resolve[ForAll[b, b >= \
1, 2 + 1/b <= 3], Reals]]\
\>", "Input",

}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Sec. II C: the Lyapunov expression 2 y (-y/2) + D(y) equals c - (1-b) \
y^2, which is at most a constant minus a positive multiple of y^2 exactly \
when b < 1\",
  Simplify[2 y (-y/2) + (c + b y^2) - (c - (1 - b) y^2)] === 0 &&
   And @@ Table[Resolve[ForAll[y, 1 - (1 - b) y^2 <= 1 - (1 - b)/2 y^2], \
Reals], {b, {0, 1/3, 9/10}}] &&
   And @@ Flatten@Table[! Resolve[ForAll[y, 1 - (1 - b) y^2 <= c1 - c0 y^2], \
Reals], {b, {1, 2}}, {c0, {1/100, 1}}, {c1, {1, 100}}]]\
\>", "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"2e39e4ff-ca60-4667-9b3e-46a60d657db5"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Sec. II C: the Lyapunov expression 2 y (-y/2) + D(y) equals c - (1-b) \
y^2, which is at most a constant minus a positive multiple of y^2 exactly \
when b < 1\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653233449573*^9},
 CellLabel->"Out[34]=",ExpressionUUID->"3116783f-c5cd-4d9b-a3bd-6fe3a627bf40"]
}, Open  ]]
}, Open  ]],


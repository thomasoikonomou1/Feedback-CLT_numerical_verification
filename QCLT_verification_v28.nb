Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Lemma 6 (additional numerical check): the trapezoidal value of W1(g \
K^eps, g) agrees with adaptive integration (NIntegrate) within 1% (b = 1/3, \

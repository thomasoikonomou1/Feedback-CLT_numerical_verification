Cell[CellGroupData[{

Cell["\<\
check[\"Table II: at the largest N the Kolmogorov distance is at the level of \
the sampling floor in all eleven cases (below 1.95/Sqrt[M] + 0.002)\",
  And @@ Table[Last[sims[cs][\"ks\"]] < 1.95/Sqrt[mPaths] + 0.002, {cs, \
cases}]]\
\>", "Input",
 CellLabel->
  "In[127]:=",ExpressionUUID->"a11e0228-611a-41a2-85b5-e50f1b640754"],

Cell[BoxData[
 TemplateBox[{

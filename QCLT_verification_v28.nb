Cell[CellGroupData[{

Cell["\<\
check[\"Remark after Theorem B (additional simulation, displaced start): for \
the start S_1 = 4 the measured W_1 agrees with the lower bound 4/Sqrt[N] \
within 8% at every checkpoint\", And @@ (Abs[# - 1] < 0.08 & /@ (simD[\"w1\"] \
Sqrt[cps]/4))]\
\>", "Input",
 CellLabel->
  "In[135]:=",ExpressionUUID->"64bbae17-49b2-4aaf-84da-0e2250f4ddca"],


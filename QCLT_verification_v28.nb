}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Prop. C: q -> 1 as b -> 0, q -> 2 as b -> Infinity, q -> -Infinity as \
b -> -1/2 from above\",
  Limit[qOf[b], b -> 0] == 1 && Limit[qOf[b], b -> Infinity] == 2 && \
Limit[qOf[b], b -> -1/2, Direction -> \"FromAbove\"] == -Infinity]\
\>", "Input",

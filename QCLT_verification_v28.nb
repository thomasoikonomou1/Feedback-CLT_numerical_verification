    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Fig. 1, additional runs: at the largest N the Kolmogorov distance to \
g_b is below 1.95/Sqrt[M] + 0.002 (b = -1/3, -1/6, 0)\""},
  "RowDefault"]], "Output",

c(1+b)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.0036537426915293`*^9},
 CellLabel->
  "Out[212]=",ExpressionUUID->"6fc49c66-61ad-4594-8302-92aa663641c2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Remark (the growth condition): with M3 = 1 and theta = theta_*, b_N = \
(theta_* ln N)^(2/3) is about 1.17 at N = 10^10\",
  Abs[(Log[10.^10]/(8 Sqrt[2] (Zeta[3/2] - 1)))^(2/3) - 1.168] < 0.001]\
\>", "Input",

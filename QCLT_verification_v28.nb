          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"118", "\<\"Prop. E (i): g_b is even, so Int y g_b = 0, and Int |y| \
g_b = 2 Q(0) = 2 c g_b(0) (same values of b and c)\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"119", "\<\"Prop. E (i), example: for g proportional to Exp[-y^4], \
(B.2) gives D = (Sqrt[Pi]/4) Exp[y^4] Erfc[y^2] (numerical, y = -3/2..2), \
which satisfies (B.1) and is not of the form c + b y^2\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"120", "\<\"Prop. E (ii): Q = Q0 (D/c)^(-1/(2b)) solves Q' = -(y/D) \
Q with D = c + b y^2 and Q(0) = Q0 (and Q0 Exp[-y^2/(2c)] for b = 0); a \
linear first-order equation has no other solution with this initial \
value\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"121", "\<\"Prop. E (ii): g = Q/D with Q proportional to D^(-1/(2b)) \
is proportional to D^(-1-1/(2b)), the density g_b (II.2)\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"122", "\<\"Prop. E (ii): for b < 0 and l < L = Sqrt[c/|b|], Q(l) = \
Q(0)(1 - |b| l^2/c)^(1/(2|b|)) > 0, so the boundary condition in (B.1) forces \
l = L (b = -1/4, -1/2, -1; c = 1; l = L/2, 9L/10, 99L/100)\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"123", "\<\"Prop. E (ii): for b >= 0, Q(y) > 0 for every finite y \
and Q -> 0 as |y| -> Infinity, so l = Infinity (b = 0, 1/3, 1, 2; c = 1)\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"124", "\<\"Prop. E (iii): Int_y^l t v(t)^(1/(1-q)) dt = \
v(y)^((2-q)/(1-q))/(2 B (2-q)) (q = -1, 0, 1/2, 7/5, 5/3, 9/5; B = 1/2, 3; y \
= 0 and two interior points; numerical)\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"125", "\<\"Prop. E (iii): v/(2B(2-q)) = c + b y^2 with c = \
1/(2B(2-q)) and b = (q-1)/(2(2-q)) (symbolic)\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"126", "\<\"Prop. E (iii): b = (q-1)/(2(2-q)) > -1/2 for every q < \
2; inverting, q = (1+4b)/(1+2b) and B = (1+2b)/(2c)\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"127", "\<\"Prop. E (iii): for q = 1, g proportional to Exp[-B y^2] \
gives D = 1/(2B) by (B.2), the case b = 0 of c + b y^2\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"128", "\<\"Prop. E (iii): for 2 <= q < 3 the q-Gaussian has no \
first moment, Int_0^r y [1 + (q-1) B y^2]^(-1/(q-1)) dy -> Infinity as r -> \
Infinity (q = 2, 9/4, 5/2, 11/4; B = 1, 3); hence (i) excludes it\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"129", "\<\"Prop. E (iii): the case q = 2 is the Cauchy law: [1 + B \
y^2]^(-1) with B = 1/c is proportional to c/(Pi(c + y^2))\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]}
       },
       AutoDelete->False,
       GridBoxAlignment->{"Columns" -> {Right, Left, Center}},
       GridBoxBackground->{
        "Columns" -> {{None}}, "RowsIndexed" -> {1 -> GrayLevel[0.85]}},

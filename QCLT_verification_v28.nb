Cell["\<\
binDevQ2 = Module[{edges = -6. + 12. Range[0, 20]/20, cnt, ex}, cnt = \
BinCounts[yQ2, {edges}]/N[Length[yQ2]];
   ex = Differences[tCDF[1. + 1/50, edges]]; Max[Abs[cnt - ex]/Sqrt[ex (1 - \
ex)/Length[yQ2]]]];\
\>", "Input",
 CellLabel->
  "In[226]:=",ExpressionUUID->"13f3a568-516c-40d2-a72f-a90b3f343fdc"],

Cell[CellGroupData[{

Cell["\<\
check[\"Figure 1, last panel: the bin probabilities (20 bins in [-6, 6]) \
agree with those of g_50 within six standard errors\", binDevQ2 < 6]\
\>", "Input",
 CellLabel->
  "In[227]:=",ExpressionUUID->"42156faa-dc49-465b-9b77-64d85847aa39"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Figure 1, last panel: the bin probabilities (20 bins in [-6, 6]) agree \
with those of g_50 within six standard errors\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653913019184*^9},
 CellLabel->
  "Out[227]=",ExpressionUUID->"dd5f4522-531a-4fd0-b78e-7c08a3ac10de"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Figure 1, last panel: the mass outside |y| <= 6 agrees with that of \
g_50 (0.1018) within five standard errors; for the Cauchy law it is 0.1051\",
  Abs[Mean[UnitStep[Abs[yQ2] - 6.]] - 2 (1 - tCDF[1. + 1/50, 6.])] < 5 \
Sqrt[0.102 0.898/Length[yQ2]] && Abs[2 (1 - cauchyCDF[6.]) - 0.10514] < 10^-4]\
\>", "Input",
 CellLabel->
  "In[228]:=",ExpressionUUID->"f9f588de-6eae-4a40-8a58-6ec12a0bbddd"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Figure 1, last panel: the mass outside |y| <= 6 agrees with that of \
g_50 (0.1018) within five standard errors; for the Cauchy law it is 0.1051\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.0036539130260067`*^9},
 CellLabel->
  "Out[228]=",ExpressionUUID->"3d24592e-884a-46a6-a913-d3cc7b0521cf"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
10. Appendix B: Proposition E (quadratic feedback characterizes the \
q-Gaussians)\
\>", "Section",ExpressionUUID->"9616b745-04ee-4f69-bd88-e2613e02e3a2"],

Cell["\<\
Part (i): the formula (B.2) for D, for a generic density and for every g_b, \
and a non-quadratic example. Part (ii): with D = c + b y^2 the solution of \
(B.1) is g_b, on I_b. Part (iii): the q-Gaussians with q < 2 give D = c + b \
y^2 with b > -1/2, and those with 2 <= q < 3, among them the Cauchy law, have \
no first moment. All checks are exact or by numerical integration and take \
well under a minute.\
\>", "Text",ExpressionUUID->"5a939d2b-901d-4845-a22a-37f95b2231ba"],

Cell["\<\
Part (i): formula (B.2). For any density g, D = (1/g) Int_y^l t g dt \
satisfies (B.1); here gg is a generic function\
\>", "Text",ExpressionUUID->"de755ff3-89f3-4dbf-8508-2f1c7d5d1f50"],

Cell[CellGroupData[{

Cell["\<\
check[\"Prop. E (i): D = (1/g) Int_y^l t g(t) dt satisfies (D g)' = -y g for \
a generic function g\",
  Simplify[D[Integrate[t gg[t], {t, y, l}], y] + y gg[y]] === 0]\
\>", "Input",
 CellLabel->
  "In[229]:=",ExpressionUUID->"187d2611-6ef4-43d0-bbd0-c7f29a99c101"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Prop. E (i): D = (1/g) Int_y^l t g(t) dt satisfies (D g)' = -y g for a \
generic function g\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653913105298*^9},
 CellLabel->
  "Out[229]=",ExpressionUUID->"9ef01d50-4677-4259-95e6-18a485df88c6"]
}, Open  ]],

Cell["\<\
(B.2) applied to the limit laws g_b recovers D = c + b y^2. tailTG[b, c, y0] \
is Int_y0^l t g_b(t) dt, exact for b < 0 and numerical for b > 0\
\>", "Text",ExpressionUUID->"3d0fd8d2-4727-4727-956a-ba7ae7b66636"],

Cell["\<\
tailTG[b_, c_, y0_] := If[b > 0, NIntegrate[t (c + b t^2)^(-kap[b]), {t, y0, \
Infinity}, WorkingPrecision -> 30, PrecisionGoal -> 12],
    Integrate[t (c + b t^2)^(-kap[b]), {t, y0, Sqrt[-c/b]}]]/zz[b, c];\
\>", "Input",
 CellLabel->
  "In[230]:=",ExpressionUUID->"e0aee621-163b-4f6a-b21e-42b467d359cd"],

Cell[CellGroupData[{

Cell["\<\
check[\"Prop. E (i): (B.2) applied to g_b gives D = c + b y^2 (b = 1/3, 1, 2, \
-1/4, -1/2, -1; c = 1, 23/10; y = 0, 1/2, 3, 20 for b > 0 and y = 0, L/3, \
2L/3 for b < 0)\",
  And @@ Flatten@Table[close[tailTG[b, c, y]/gb[y, b, c], c + b y^2, 10^-8],
     {b, {1/3, 1, 2, -1/4, -1/2, -1}}, {c, {1, 23/10}},
     {y, If[b > 0, {0, 1/2, 3, 20}, {0, 1/3, 2/3} Sqrt[-c/b]]}]]\
\>", "Input",
 CellLabel->
  "In[231]:=",ExpressionUUID->"c9614803-5ccd-4ed8-848e-7f64a484d109"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Prop. E (i): (B.2) applied to g_b gives D = c + b y^2 (b = 1/3, 1, 2, \
-1/4, -1/2, -1; c = 1, 23/10; y = 0, 1/2, 3, 20 for b > 0 and y = 0, L/3, \
2L/3 for b < 0)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653921577273*^9},
 CellLabel->
  "Out[231]=",ExpressionUUID->"6d7a87b1-5271-4ccd-9fe5-e480fd8653de"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Prop. E (i): g_b is even, so Int y g_b = 0, and Int |y| g_b = 2 Q(0) \
= 2 c g_b(0) (same values of b and c)\",
  And @@ Flatten@Table[
     (And @@ Table[gb[-y0, b, c] == gb[y0, b, c], {y0, {1/5, 1/2, 9/10} If[b \
> 0, 10, Sqrt[-c/b]]}]) &&
      close[2 tailTG[b, c, 0], 2 c gb[0, b, c], 10^-8],
     {b, {1/3, 1, 2, -1/4, -1/2, -1}}, {c, {1, 23/10}}]]\
\>", "Input",
 CellLabel->
  "In[232]:=",ExpressionUUID->"d7ca094d-29db-47e8-9c35-512382be96a0"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Prop. E (i): g_b is even, so Int y g_b = 0, and Int |y| g_b = 2 Q(0) = \
2 c g_b(0) (same values of b and c)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653924328348*^9},
 CellLabel->
  "Out[232]=",ExpressionUUID->"5a64739b-b2f3-4821-a3f4-6d0106a1f7de"]
}, Open  ]],

Cell["\<\
A non-quadratic example: for g proportional to Exp[-y^4], (B.2) gives the \
variance function D below. It satisfies (B.1) but is not of the form c + b \
y^2; it even decreases with |y|\
\>", "Text",ExpressionUUID->"b137a5c4-9bd7-433d-9b40-36c1897b78ed"],

Cell["dQuartic[y_] := Sqrt[Pi]/4 Exp[y^4] Erfc[y^2];", "Input",
 CellLabel->
  "In[233]:=",ExpressionUUID->"cb595b6a-719e-430a-9ee6-b13f241f9d5e"],

Cell[CellGroupData[{

Cell["\<\
check[\"Prop. E (i), example: for g proportional to Exp[-y^4], (B.2) gives D \
= (Sqrt[Pi]/4) Exp[y^4] Erfc[y^2] (numerical, y = -3/2..2), which satisfies \
(B.1) and is not of the form c + b y^2\",
  And @@ Table[close[NIntegrate[t Exp[-t^4], {t, y0, Infinity}, \
WorkingPrecision -> 30] Exp[y0^4], dQuartic[y0], 10^-10], {y0, {-3/2, -1/2, \
0, 1/2, 1, 2}}] &&
   Simplify[D[dQuartic[y] Exp[-y^4], y] + y Exp[-y^4]] === 0 &&
   Abs[N[(dQuartic[2] - dQuartic[0])/(dQuartic[1] - dQuartic[0]) - 4]] > 1 && \
N[dQuartic[2]] < N[dQuartic[1]] < N[dQuartic[0]]]\
\>", "Input",
 CellLabel->
  "In[234]:=",ExpressionUUID->"2e3f3248-2bc3-4ba0-91e0-7dd12786593a"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Prop. E (i), example: for g proportional to Exp[-y^4], (B.2) gives D = \
(Sqrt[Pi]/4) Exp[y^4] Erfc[y^2] (numerical, y = -3/2..2), which satisfies \
(B.1) and is not of the form c + b y^2\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653924412096*^9},
 CellLabel->
  "Out[234]=",ExpressionUUID->"f86c51f0-c85e-4cd3-a8e4-f35eee06fc02"]
}, Open  ]],

Cell["\<\
Part (ii): with D = c + b y^2 the equation Q' = -(y/D) Q has the solution \
Q(0) (D/c)^(-1/(2b))\
\>", "Text",ExpressionUUID->"e7593cc9-b866-4a8c-a0a6-bbe1887ddd4e"],

Cell[CellGroupData[{

Cell["\<\
check[\"Prop. E (ii): Q = Q0 (D/c)^(-1/(2b)) solves Q' = -(y/D) Q with D = c \
+ b y^2 and Q(0) = Q0 (and Q0 Exp[-y^2/(2c)] for b = 0); a linear first-order \
equation has no other solution with this initial value\",
  Simplify[D[((c + b y^2)/c)^(-1/(2 b)), y] + y ((c + b y^2)/c)^(-1/(2 b))/(c \
+ b y^2)] === 0 &&
   (((c + b y^2)/c)^(-1/(2 b)) /. y -> 0) === 1 &&
   Simplify[D[Exp[-y^2/(2 c)], y] + y Exp[-y^2/(2 c)]/c] === 0]\
\>", "Input",
 CellLabel->
  "In[235]:=",ExpressionUUID->"76c5e4a1-9ea7-4e68-8855-13bd3cbf403f"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Prop. E (ii): Q = Q0 (D/c)^(-1/(2b)) solves Q' = -(y/D) Q with D = c + \
b y^2 and Q(0) = Q0 (and Q0 Exp[-y^2/(2c)] for b = 0); a linear first-order \
equation has no other solution with this initial value\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653924442606*^9},
 CellLabel->
  "Out[235]=",ExpressionUUID->"da998cb7-d347-491b-b2a4-133d38b2a31f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Prop. E (ii): g = Q/D with Q proportional to D^(-1/(2b)) is \
proportional to D^(-1-1/(2b)), the density g_b (II.2)\",
  FullSimplify[(c + b y^2)^(-1/(2 b))/(c + b y^2) == (c + b y^2)^(-kap[b]), \
Assumptions -> c + b y^2 > 0]]\
\>", "Input",
 CellLabel->
  "In[236]:=",ExpressionUUID->"8205a3b9-1290-4330-8aa6-c2f9f2514463"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Prop. E (ii): g = Q/D with Q proportional to D^(-1/(2b)) is \
proportional to D^(-1-1/(2b)), the density g_b (II.2)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653924458445*^9},
 CellLabel->
  "Out[236]=",ExpressionUUID->"5f9c8422-b8d9-4e04-9b19-6df8ae796253"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Prop. E (ii): for b < 0 and l < L = Sqrt[c/|b|], Q(l) = Q(0)(1 - |b| \
l^2/c)^(1/(2|b|)) > 0, so the boundary condition in (B.1) forces l = L (b = \
-1/4, -1/2, -1; c = 1; l = L/2, 9L/10, 99L/100)\",
  And @@ Flatten@Table[(1 + b l^2)^(-1/(2 b)) > 0 /. l -> f Sqrt[-1/b], {b, \
{-1/4, -1/2, -1}}, {f, {1/2, 9/10, 99/100}}] &&
   And @@ Table[((1 + b l^2)^(-1/(2 b)) /. l -> Sqrt[-1/b]) == 0, {b, {-1/4, \
-1/2, -1}}]]\
\>", "Input",
 CellLabel->
  "In[237]:=",ExpressionUUID->"1580af3c-7d38-4379-9466-4b959de44cbb"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Prop. E (ii): for b < 0 and l < L = Sqrt[c/|b|], Q(l) = Q(0)(1 - |b| \
l^2/c)^(1/(2|b|)) > 0, so the boundary condition in (B.1) forces l = L (b = \
-1/4, -1/2, -1; c = 1; l = L/2, 9L/10, 99L/100)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653924464835*^9},
 CellLabel->
  "Out[237]=",ExpressionUUID->"eeca7d80-8d86-4653-8dbc-4fea271c8431"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Prop. E (ii): for b >= 0, Q(y) > 0 for every finite y and Q -> 0 as \
|y| -> Infinity, so l = Infinity (b = 0, 1/3, 1, 2; c = 1)\",
  And @@ Table[And @@ Table[(If[b == 0, Exp[-y^2/2], (1 + b y^2)^(-1/(2 b))] \
/. y -> 10^k) > 0, {k, 0, 3}] &&
     Limit[If[b == 0, Exp[-y^2/2], (1 + b y^2)^(-1/(2 b))], y -> Infinity] == \
0, {b, {0, 1/3, 1, 2}}]]\
\>", "Input",
 CellLabel->
  "In[238]:=",ExpressionUUID->"49084d62-3e22-4b81-822b-f9c85089e3a6"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Prop. E (ii): for b >= 0, Q(y) > 0 for every finite y and Q -> 0 as |y| \
-> Infinity, so l = Infinity (b = 0, 1/3, 1, 2; c = 1)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653924479259*^9},
 CellLabel->
  "Out[238]=",ExpressionUUID->"c2167c3e-655f-4ddb-a41e-6de29530f152"]
}, Open  ]],

Cell["\<\
Part (iii): the q-Gaussians. v = 1 - (1-q) B y^2; l is the end of the \
interval where v > 0\
\>", "Text",ExpressionUUID->"e76ccb75-f06e-4baa-8144-ad7d7ec2dd68"],

Cell["vq[q_, bB_, y_] := 1 - (1 - q) bB y^2;", "Input",
 CellLabel->
  "In[239]:=",ExpressionUUID->"3b2ed351-4b3a-48fa-8474-b7fdaf779a91"],

Cell["lq[q_, bB_] := If[q < 1, 1/Sqrt[(1 - q) bB], Infinity];", "Input",
 CellLabel->
  "In[240]:=",ExpressionUUID->"5da17e37-8fd8-4488-9b1d-deeac0a62281"],

Cell[CellGroupData[{

Cell["\<\
check[\"Prop. E (iii): Int_y^l t v(t)^(1/(1-q)) dt = v(y)^((2-q)/(1-q))/(2 B \
(2-q)) (q = -1, 0, 1/2, 7/5, 5/3, 9/5; B = 1/2, 3; y = 0 and two interior \
points; numerical)\",
  And @@ Flatten@Table[
     close[NIntegrate[t vq[q, bB, t]^(1/(1 - q)), {t, y, lq[q, bB]}, \
WorkingPrecision -> 30, PrecisionGoal -> 12],
      vq[q, bB, y]^((2 - q)/(1 - q))/(2 bB (2 - q)), 10^-8],
     {q, {-1, 0, 1/2, 7/5, 5/3, 9/5}}, {bB, {1/2, 3}}, {y, If[q < 1, {0, 1/3, \
4/5} lq[q, bB], {0, 1, 7}]}]]\
\>", "Input",
 CellLabel->
  "In[241]:=",ExpressionUUID->"54215721-b9b3-440e-bee4-f99a1e46e6b0"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Prop. E (iii): Int_y^l t v(t)^(1/(1-q)) dt = v(y)^((2-q)/(1-q))/(2 B \
(2-q)) (q = -1, 0, 1/2, 7/5, 5/3, 9/5; B = 1/2, 3; y = 0 and two interior \
points; numerical)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653924685855*^9},
 CellLabel->
  "Out[241]=",ExpressionUUID->"646dca23-3217-4136-8443-fe9ac9fa83d6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Prop. E (iii): v/(2B(2-q)) = c + b y^2 with c = 1/(2B(2-q)) and b = \
(q-1)/(2(2-q)) (symbolic)\",
  Simplify[(1 - (1 - q) bB y^2)/(2 bB (2 - q)) - (1/(2 bB (2 - q)) + (q - \
1)/(2 (2 - q)) y^2)] === 0]\
\>", "Input",
 CellLabel->
  "In[242]:=",ExpressionUUID->"f30438fa-b835-4832-a1a6-35e9e0ca001a"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Prop. E (iii): v/(2B(2-q)) = c + b y^2 with c = 1/(2B(2-q)) and b = \
(q-1)/(2(2-q)) (symbolic)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653924691989*^9},
 CellLabel->
  "Out[242]=",ExpressionUUID->"6ab991ca-dfc8-4507-859d-b3f7e977f3c2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Prop. E (iii): b = (q-1)/(2(2-q)) > -1/2 for every q < 2; inverting, \
q = (1+4b)/(1+2b) and B = (1+2b)/(2c)\",
  Reduce[(q - 1)/(2 (2 - q)) <= -1/2 && q < 2, q, Reals] === False &&
   Simplify[qOf[(q - 1)/(2 (2 - q))] - q] === 0 &&
   Simplify[(1 + 2 (q - 1)/(2 (2 - q)))/(2/(2 bB (2 - q))) - bB] === 0]\
\>", "Input",
 CellLabel->
  "In[243]:=",ExpressionUUID->"6c915a41-3588-4c4f-a004-52e6d79c51df"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Prop. E (iii): b = (q-1)/(2(2-q)) > -1/2 for every q < 2; inverting, q \
= (1+4b)/(1+2b) and B = (1+2b)/(2c)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.0036539247098827`*^9},
 CellLabel->
  "Out[243]=",ExpressionUUID->"a76aa64f-3b40-4f47-b39e-7487048e2201"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Prop. E (iii): for q = 1, g proportional to Exp[-B y^2] gives D = \
1/(2B) by (B.2), the case b = 0 of c + b y^2\",
  Simplify[Integrate[t Exp[-bB t^2], {t, y, Infinity}, Assumptions -> bB > 0 \
&& Element[y, Reals]]/Exp[-bB y^2] - 1/(2 bB)] === 0]\
\>", "Input",
 CellLabel->
  "In[244]:=",ExpressionUUID->"731c2ea3-9098-4a95-963c-02a9134a1e81"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Prop. E (iii): for q = 1, g proportional to Exp[-B y^2] gives D = \
1/(2B) by (B.2), the case b = 0 of c + b y^2\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653925159245*^9},
 CellLabel->
  "Out[244]=",ExpressionUUID->"9d24565b-19cc-4870-8780-8001c38503ff"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Prop. E (iii): for 2 <= q < 3 the q-Gaussian has no first moment, \
Int_0^r y [1 + (q-1) B y^2]^(-1/(q-1)) dy -> Infinity as r -> Infinity (q = \
2, 9/4, 5/2, 11/4; B = 1, 3); hence (i) excludes it\",
  And @@ Flatten@Table[
     Limit[Integrate[y (1 + (q - 1) bB y^2)^(-1/(q - 1)), {y, 0, rr}, \
Assumptions -> rr > 0], rr -> Infinity] === Infinity,
     {q, {2, 9/4, 5/2, 11/4}}, {bB, {1, 3}}]]\
\>", "Input",
 CellLabel->
  "In[245]:=",ExpressionUUID->"1b5b7fba-f93c-4e9f-806d-39001589df43"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Prop. E (iii): for 2 <= q < 3 the q-Gaussian has no first moment, \
Int_0^r y [1 + (q-1) B y^2]^(-1/(q-1)) dy -> Infinity as r -> Infinity (q = \
2, 9/4, 5/2, 11/4; B = 1, 3); hence (i) excludes it\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653932654489*^9},
 CellLabel->
  "Out[245]=",ExpressionUUID->"58c6c128-9c17-4639-9225-cdfbf264b13d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Prop. E (iii): the case q = 2 is the Cauchy law: [1 + B y^2]^(-1) \
with B = 1/c is proportional to c/(Pi(c + y^2))\",
  Simplify[(1 + y^2/c)^(-1) - c/(c + y^2)] === 0]\
\>", "Input",
 CellLabel->
  "In[246]:=",ExpressionUUID->"abc3d644-2827-4d4b-a565-940fc825c84b"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Prop. E (iii): the case q = 2 is the Cauchy law: [1 + B y^2]^(-1) with \
B = 1/c is proportional to c/(Pi(c + y^2))\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653932700624*^9},
 CellLabel->
  "Out[246]=",ExpressionUUID->"c6b11a31-d878-417a-bf1d-f697a2cd1bc1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. Summary: pass/fail table", "Section",ExpressionUUID->"190040d6-8c06-45df-84fc-6a35c9903dad"],

Cell["All checks of Sections 1 to 10, in the order evaluated.", "Text",ExpressionUUID->"03efb8f1-cf37-4060-9bdf-1fc99a2ef4e4"],

Cell[CellGroupData[{

Cell["\<\
summaryTable = Module[{rows = MapIndexed[{#2[[1]], #1[[1]], Style[If[#1[[2]], \
\"PASS\", \"FAIL\"], Bold, If[#1[[2]], Darker[Green], Red]]} &, List @@@ \
Normal[results]]},
   Grid[Prepend[rows, Style[#, Bold] & /@ {\"#\", \"Check (equation or \
statement of the manuscript)\", \"Result\"}], Frame -> All,
    Alignment -> {{Right, Left, Center}}, Background -> {None, {1 -> \
LightGray}}, Spacings -> {1, 0.6}, ItemSize -> {{Automatic, 60, \
Automatic}}]];
Column[{Style[ToString[Count[Values[results], True]] <> \" of \" <> \
ToString[Length[results]] <> \" checks passed\", Bold, 16], summaryTable}, \
Spacings -> 1]\
\>", "Input",
 CellLabel->
  "In[247]:=",ExpressionUUID->"eb92bf25-9f15-45ce-98e1-39dc3de526bb"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"129 of 129 checks passed\"\>",
      StripOnInput->False,
      FontSize->16,
      FontWeight->Bold]},
    {
     TagBox[GridBox[{
        {
         StyleBox["\<\"#\"\>",
          StripOnInput->False,
          FontWeight->Bold], 
         StyleBox["\<\"Check (equation or statement of the manuscript)\"\>",
          StripOnInput->False,
          FontWeight->Bold], 
         StyleBox["\<\"Result\"\>",
          StripOnInput->False,
          FontWeight->Bold]},
        {"1", "\<\"(II.2): closed form of Z_b equals the integral of \
D^(-kappa) (b = 1/3, 1, 2, -1/4, -1/2, -1; c = 1, 23/10)\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"2", "\<\"(II.3): (1-q) B = -b/c and 1/(1-q) = -kappa, with q = \
(1+4b)/(1+2b) and B = (1+2b)/(2c)\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"3", "\<\"(II.3): inverse relation b = (q-1)/(2(2-q))\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"4", "\<\"Sec. II A: g_b is proportional to [1-(1-q) B \
y^2]^(1/(1-q)) (the ratio does not depend on y)\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"5", "\<\"Sec. II A: for b > 0, g_b is the law of Sqrt[c/(1+b)] T \
with T a Student variable with 1 + 1/b degrees of freedom\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"6", "\<\"Sec. II A: for b < 0, g_b is the law of L(2V-1) with V a \
Beta(1/(2|b|), 1/(2|b|)) variable\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          GraphicsColor->RGBColor[0, 
            Rational[2, 3], 0],
          FontWeight->Bold,
          FontColor->RGBColor[0, 

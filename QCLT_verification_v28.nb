Cell["\<\
Figure 1, last panel (j), q = 2: histogram of S_N/Sqrt[N] at the largest N \
for b = 50, c_b = 1 + b, noise +1/-1 (points), and the Cauchy density \
1/(Pi(1+y^2)) (line)\
\>", "Text",ExpressionUUID->"6e269458-9cb7-4b60-b4cd-4e5d8601cb3a"],

Cell["\<\
yQ2 = SelectFirst[q2, #[\"b\"] == 50 && #[\"noise\"] == \"rademacher\" \
&][\"final\"];\
\>", "Input",
 CellLabel->
  "In[223]:=",ExpressionUUID->"08b4c83c-f54d-4002-bac0-951a6d10a1ce"],

Cell["\<\
panelQ2 = Module[{edges = -6. + 12. Range[0, 60]/60, cnt, mid, hts, ymax},
   cnt = BinCounts[yQ2, {edges}]; mid = (Most[edges] + Rest[edges])/2; hts = \
cnt/(Length[yQ2] 0.2); ymax = 1.12 Max[hts];
   Show[Plot[1/(Pi (1 + y^2)), {y, -6, 6}, PlotStyle -> Directive[colO, \
Thickness[0.007]], PlotRange -> {{-6, 6}, {0, ymax}}, PlotPoints -> 200],
    ListPlot[Transpose[{mid, hts}], PlotStyle -> Directive[colB, \
PointSize[0.02]]],
    Frame -> True, Axes -> False, PlotRange -> {{-6, 6}, {0, ymax}}, \
PlotLabel -> Style[\"q = 2 (Corollary D, b = 50)\\nCauchy law, noise \
\[PlusMinus]1\", 10],
    FrameLabel -> {\"y\", None}, ImageSize -> 230]];\
\>", "Input",
 CellLabel->
  "In[224]:=",ExpressionUUID->"a4d32c3b-23fe-48a9-82b5-e5019f14ee1f"],

Cell[CellGroupData[{

Cell["fig1Q2 = Grid[Partition[Append[fig1Panels, panelQ2], 5]]", "Input",
 CellLabel->
  "In[225]:=",ExpressionUUID->"6181c08b-950b-4f7e-92ff-4014a9286977"],


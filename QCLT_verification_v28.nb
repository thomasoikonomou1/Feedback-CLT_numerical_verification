Cell["\<\
Sec. III, the summands (II.1) satisfy (A1)-(A3): the recursion (II.1) \
satisfies the hypotheses\
\>", "Text",ExpressionUUID->"5c110ec7-ae8c-4bb3-a67b-67ff5d4b8871"],

Cell[CellGroupData[{

Cell["\<\
check[\"Sec. III, the summands (II.1) satisfy (A1)-(A3): (beta S^2/n + c - \
beta S^2/n)(n/beta + K^2) = c (n/beta + K^2), and c (n+1)/beta - c (n/beta + \
K^2) = c (1 - beta K^2)/beta\",
  Simplify[(be s^2/n + c - be s^2/n) (n/be + kk^2) == c (n/be + kk^2)] && \
Simplify[c (n + 1)/be - c (n/be + kk^2) == c (1 - be kk^2)/be]]\
\>", "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"19720cdc-e60b-4074-bfac-b77cae89da7a"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Sec. III, the summands (II.1) satisfy (A1)-(A3): (beta S^2/n + c - beta \
S^2/n)(n/beta + K^2) = c (n/beta + K^2), and c (n+1)/beta - c (n/beta + K^2) \
= c (1 - beta K^2)/beta\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653235764736*^9},
 CellLabel->"Out[57]=",ExpressionUUID->"1ecb331f-8b71-461a-b312-3f84423d37a7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Sec. III, the summands (II.1) satisfy (A1)-(A3) (numerical): |S + \
Sqrt[c - beta S^2/n] x| <= Sqrt[c (n+1)/beta] whenever |S| <= Sqrt[c n/beta], \
|x| <= K and beta K^2 = 1\",
  And @@ Flatten@Table[With[{smax = Sqrt[c n/be], kk = 1/Sqrt[be]}, N[Abs[u \
smax + Sqrt[c - be (u smax)^2/n] v kk]] <= N[Sqrt[c (n + 1)/be]] + 10^-12],
    {be, {1/4, 1/2, 1}}, {c, {1, 23/10}}, {n, {1, 2, 5, 40}}, {u, -1, 1, \
1/10}, {v, -1, 1, 1/5}]]\
\>", "Input",
 CellLabel->"In[58]:=",ExpressionUUID->"3410e8fc-9d9e-430d-a664-185e3e9890e4"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Sec. III, the summands (II.1) satisfy (A1)-(A3) (numerical): |S + \
Sqrt[c - beta S^2/n] x| <= Sqrt[c (n+1)/beta] whenever |S| <= Sqrt[c n/beta], \
|x| <= K and beta K^2 = 1\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653236101261*^9},
 CellLabel->"Out[58]=",ExpressionUUID->"7f9f7f22-b543-4592-b260-b0da04372e24"]
}, Open  ]],


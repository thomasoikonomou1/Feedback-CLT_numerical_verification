Cell["\<\
binDev[b_, kind_] := Module[{yN = sims[{b, kind}][\"final\"], lo, hi, nb = \
20, edges, cnt, ex},
   {lo, hi} = range1[b]; edges = lo + (hi - lo) Range[0, nb]/nb; cnt = \
BinCounts[yN, {edges}]/N[Length[yN]];
   ex = Differences[cdfG[b, edges]]; Max[Abs[cnt - ex]/Sqrt[ex (1 - \
ex)/Length[yN] + 10^-12]]];\
\>", "Input",
 CellLabel->
  "In[148]:=",ExpressionUUID->"a73df3fd-5be2-43f1-876a-189f24115e91"],

Cell["\<\
fig1Cases = {{-1, \"rademacher\"}, {-1/2, \"three\"}, {-1/3, \"three\"}, \
{-1/4, \"two\"}, {-1/6, \"uniform\"}, {0, \"exp\"}, {1/3, \"exp\"}, {1, \
\"gauss\"}, {2, \"rademacher\"}};\
\>", "Input",
 CellLabel->
  "In[149]:=",ExpressionUUID->"d1700a09-fff9-40d2-87a0-af188be09f80"],

Cell[CellGroupData[{

Cell["fig1Dev = Table[binDev[cs[[1]], cs[[2]]], {cs, fig1Cases}]", "Input",
 CellLabel->
  "In[150]:=",ExpressionUUID->"5445c9d7-93e7-4104-ab4d-2a847c923318"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "2.1000511048651984`", ",", "1.4568861928354684`", ",", 
   "2.5198970286613713`", ",", "3.0448887552323654`", ",", 
   "2.367070039282398`", ",", "2.2992067193719863`", ",", 
   "2.753978782672669`", ",", "1.7086215021875966`", ",", 
   "1.627255550781411`"}], "}"}]], "Output",
 CellChangeTimes->{4.003653641818906*^9},
 CellLabel->
  "Out[150]=",ExpressionUUID->"1348b0f8-5da4-40a5-adcc-0c3337ce8ada"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Fig. 1: in each of the nine panels (a)-(i) the bin probabilities (20 \
bins) agree with those of g_b within six standard errors\", Max[fig1Dev] < 6]\
\
\>", "Input",
 CellLabel->
  "In[151]:=",ExpressionUUID->"c5775396-840e-4bc8-a71d-e50a0fbc579b"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Fig. 1: in each of the nine panels (a)-(i) the bin probabilities (20 \
bins) agree with those of g_b within six standard errors\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653641957678*^9},
 CellLabel->
  "Out[151]=",ExpressionUUID->"e2bf731d-61b1-4a36-bb56-a2b1070618ca"]
}, Open  ]],

Cell["\<\
Figure 2: tail probability P(|S_N/Sqrt[N]| > x) at the largest N (points) and \
the exact tail of g_b (lines), b = 1/3, 1, 2\
\>", "Text",ExpressionUUID->"42761381-7fc1-4308-9ebc-d89a89b6cace"],

Cell["\<\
tailExact[b_, x_] := BetaRegularized[(1 + 1/b)/((1 + 1/b) + (1 + b) x^2), (1 \
+ 1/b)/2, 1/2];\
\>", "Input",
 CellLabel->
  "In[152]:=",ExpressionUUID->"22e8ece6-c25b-4ef8-aa99-a2304f861575"],

Cell["tailXs = 10.^Range[0, 2.5, 0.1];", "Input",
 CellLabel->
  "In[153]:=",ExpressionUUID->"6de4bc42-cfa7-4686-a92f-2e2777b31324"],

Cell["\<\
tailEmp[b_, kind_] := With[{a = Abs[sims[{b, kind}][\"final\"]]}, Table[{x, \
N[Mean[UnitStep[a - x]]]}, {x, tailXs}]];\
\>", "Input",
 CellLabel->
  "In[154]:=",ExpressionUUID->"f2e8db4d-9901-41ed-bb8b-bbfdf0d48103"],

Cell["tailCases = {{1/3, \"gauss\"}, {1, \"exp\"}, {2, \"rademacher\"}};", \
"Input",
 CellLabel->
  "In[155]:=",ExpressionUUID->"189261fb-6d7f-4180-bea1-39686a9c5dd5"],

Cell["tailData = tailEmp @@@ tailCases;", "Input",
 CellLabel->
  "In[156]:=",ExpressionUUID->"408948d8-5765-47f8-ba46-f3a41eee3f37"],

Cell[CellGroupData[{

Cell["\<\
fig2 = Show[ListLogLogPlot[Select[#, #[[2]] > 0 &] & /@ tailData, PlotStyle \
-> {colB, colO, colA}, PlotMarkers -> {Automatic, 7}, PlotRange -> {{0.9, \
350}, {3*^-6, 1.2}},
    PlotLegends -> Placed[{\"b = 1/3, Gaussian noise\", \"b = 1, centred \
exponential noise\", \"b = 2, noise \[PlusMinus]1\"}, {0.3, 0.2}]],
   LogLogPlot[Evaluate[{tailExact[1/3, x], tailExact[1, x], tailExact[2, \
x]}], {x, 1, 316}, PlotStyle -> {colB, colO, colA}, PlotRange -> {{0.9, 350}, \
{3*^-6, 1.2}}],
   Frame -> True, Axes -> False, FrameLabel -> {\"x\", \"P(|Y| > x)\"}, \
ImageSize -> 440]\
\>", "Input",
 CellLabel->
  "In[157]:=",ExpressionUUID->"cd594a03-e312-4095-bb4c-4803cea76db4"],


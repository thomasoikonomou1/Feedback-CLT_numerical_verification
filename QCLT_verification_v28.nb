}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"(III.2): the terms j >= 3 are at most C_r n^((r-3)/2) (K_j = 1, L = \
3/2; r = 3..8, n = 1..50)\",
  And @@ Flatten@Table[N[Sum[Binomial[r, j] (3/2 Sqrt[n])^(r - j), {j, 3, \
r}]] <= N[Sum[Binomial[r, j] (3/2)^(r - j), {j, 3, r}] n^((r - 3)/2)] (1 + \
10^-12), {r, 3, 8}, {n, 1, 50}]]\
\>", "Input",

  "Out[139]=",ExpressionUUID->"5a148d96-cf6c-4ad7-8b3f-483b4c3d8163"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Fig. 1, additional runs: q(b) = -1, 1/2, 1 for b = -1/3, -1/6, 0, and \
for b = -1/3 the limit density is proportional to (L^2 - y^2)^(1/2), the \
semicircle law\",
  qOf[-1/3] == -1 && qOf[-1/6] == 1/2 && Limit[qOf[b], b -> 0] == 1 && (1/(2 \
(1/3)) - 1) == 1/2]\
\>", "Input",

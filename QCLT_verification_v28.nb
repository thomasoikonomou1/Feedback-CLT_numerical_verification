Cell[BoxData["2.000012142371154`"], "Output",
 CellChangeTimes->{4.003653234515477*^9},
 CellLabel->"Out[45]=",ExpressionUUID->"e1ff1074-ee22-44fe-8d1b-ffb87651e211"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Lemma 2 (illustration): x_(n+1) = (1 - lambda/n) x_n + (lambda/n) z_n \
+ e_n with z_n -> 2 and summable e_n gives x_N -> 2\", Abs[lemma2Demo - 2.] < \
10^-3]\
\>", "Input",

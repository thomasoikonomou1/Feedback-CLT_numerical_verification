Cell["Lemma 5: contraction", "Text",ExpressionUUID->"e32419fb-1ab9-4159-9d98-3f735732e4fd"],

Cell[CellGroupData[{

Cell["\<\
check[\"Lemma 5, proof (one step): x^- <= eps Sqrt[b] |xi|^3 (eps \
Sqrt[b]/rho)^2 for x = rho + eps theta xi, |theta| <= Sqrt[b]\",
  And @@ Flatten@Table[With[{rho = Sqrt[n/(n + 1)], ep = 1/Sqrt[n + 1]}, \
N[Max[-(rho + ep th Sqrt[b] xi), 0]] <= N[ep Sqrt[b] Abs[xi]^3 (ep \
Sqrt[b]/rho)^2] + 10^-12],
    {n, {1, 2, 5, 30}}, {b, {1/3, 1, 2, 10}}, {th, -1, 1, 1/4}, {xi, -6, 6, \
1/4}]]\
\>", "Input",
 CellLabel->"In[68]:=",ExpressionUUID->"0b91abd5-cec5-4446-aa2f-6993a3914f22"],


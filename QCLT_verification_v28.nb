}, Open  ]],

Cell["\<\
Remark after Theorem B (additional simulation, displaced start): displaced \
start S_1 = 4, b = 1/3, noise +1/-1\
\>", "Text",ExpressionUUID->"9fbf3ac1-c67a-4d60-874f-692e9a068b3c"],

Cell["simD = simulate[1/3, \"rademacher\", 4, mPaths, nMax, True];", "Input",
 CellLabel->
  "In[133]:=",ExpressionUUID->"c9c32481-585c-43b5-9497-2d2c846dcd68"],

Cell[CellGroupData[{

Cell["\<\
Grid[Prepend[Transpose[{cps, simD[\"w1\"], 4./Sqrt[cps], simD[\"w1\"] \
Sqrt[cps]/4}], {\"N\", \"measured W1\", \"4/Sqrt[N]\", \"ratio\"}], Frame -> \
All]\
\>", "Input",
 CellLabel->
  "In[134]:=",ExpressionUUID->"1bdbc9d9-d84b-4a91-9987-699878c9a7a3"],


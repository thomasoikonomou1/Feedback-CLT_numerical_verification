 CellLabel->"Out[46]=",ExpressionUUID->"90477d00-213e-44bd-beb4-9b9a2014390f"]
}, Open  ]],

Cell["\<\
Sec. III, convergence and identification of the moments: the limits of the \
moments are the moments of g_b\
\>", "Text",ExpressionUUID->"b4cd2adb-f1d8-424e-a7c1-076f8e70a4d2"],

Cell["\<\
mLim[r_, be_, c_] := If[r == 0, 1, (r - 1) c/(1 + (r - 1) be) mLim[r - 2, be, \
c]];\
\>", "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"242e168b-f9dc-4031-9780-342b7e817491"],

Cell["\<\
mBeta[r_, be_, c_] := With[{al = 1/(2 be)}, (c/be)^(r/2) Sum[Binomial[r, k] \
2^k (-1)^(r - k) Pochhammer[al, k]/Pochhammer[2 al, k], {k, 0, r}]];\
\>", "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"4b0e662c-2f66-49be-92fe-d65093f5149e"],

Cell[CellGroupData[{

Cell["\<\
check[\"(III.5), Sec. III, moments of g_b: the recursion gives the moments of \
g_b, computed from the Beta form with E V^k = (alpha)_k/(2 alpha)_k (beta = \
1/4, 1/2, 1, 5/2; r = 2..10)\",
  And @@ Flatten@Table[close[mBeta[r, be, 13/10], mLim[r, be, 13/10], 10^-9], \
{be, {1/4, 1/2, 1, 5/2}}, {r, 2, 10, 2}]]\
\>", "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"facc9f10-fa47-4db2-be37-ba179dbb4a32"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"(III.5), Sec. III, moments of g_b: the recursion gives the moments of \
g_b, computed from the Beta form with E V^k = (alpha)_k/(2 alpha)_k (beta = \
1/4, 1/2, 1, 5/2; r = 2..10)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653234558055*^9},
 CellLabel->"Out[49]=",ExpressionUUID->"77a4f29a-f802-4430-8443-8b3cb335671d"]
}, Open  ]],

Cell["\<\
mInt[r_, be_, c_] := NIntegrate[y^r (c - be y^2)^(-kap[-be])/zz[-be, c], {y, \
-Sqrt[c/be], Sqrt[c/be]}];\
\>", "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"284bc0fa-38cb-430e-bad6-d96bab069a82"],

Cell[CellGroupData[{

Cell["\<\
check[\"Sec. III, moments of g_b: integration by parts, m_r (1 + (r-1) beta) \
= (r-1) c m_(r-2), by numerical integration (beta = 1/4, 1/2; r = 2, 4, 6)\",
  And @@ Flatten@Table[close[Quiet@mInt[r, be, 13/10] (1 + (r - 1) be), (r - \
1) 13/10 Quiet@mInt[r - 2, be, 13/10], 10^-6], {be, {1/4, 1/2}}, {r, {2, 4, \
6}}]]\
\>", "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"e5cc7f9a-ba2b-4760-b969-4fb72edda2e2"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Sec. III, moments of g_b: integration by parts, m_r (1 + (r-1) beta) = \
(r-1) c m_(r-2), by numerical integration (beta = 1/4, 1/2; r = 2, 4, 6)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653234622809*^9},
 CellLabel->"Out[51]=",ExpressionUUID->"c6a031a5-67e3-4d09-9716-5210432172d4"]
}, Open  ]],

Cell["\<\
Sec. III, convergence of the moments without sampling: for noise +1/-1 the \
even moments of S_n obey an exact linear recursion, because E[(S + sigma \
xi)^r | S] is a polynomial in S\
\>", "Text",ExpressionUUID->"131ef76b-e83c-47ba-9108-8be49e106271"],

Cell["\<\
momStep[mu_, n_, be_, c_] := Table[Sum[Binomial[r, j] Sum[Binomial[j/2, i] \
c^(j/2 - i) (-be/n)^i mu[[(r - j)/2 + i + 1]], {i, 0, j/2}], {j, 0, r, 2}], \
{r, 0, 2 (Length[mu] - 1), 2}];\
\>", "Input",
 CellLabel->"In[52]:=",ExpressionUUID->"aeafa0ed-be1f-4c7d-9d1f-88434925f2de"],

Cell["\<\
momRad[be_, c_, nmax_, rmax_] := Module[{mu = Table[c^(r/2), {r, 0, rmax, \
2}]}, Do[mu = momStep[mu, n, be, c], {n, 1, nmax - 1}]; Table[mu[[r/2 + \
1]]/nmax^(r/2), {r, 0, rmax, 2}]];\
\>", "Input",
 CellLabel->"In[53]:=",ExpressionUUID->"86ae2fee-e2d0-45a0-bfd0-4ba03a0d1e63"],

Cell["\<\
momTable = Table[{be, nmax, Max@Abs[momRad[N[be], 1., nmax, 8]/Table[mLim[r, \
be, 1], {r, 0, 8, 2}] - 1]}, {be, {1/4, 1/2, 1}}, {nmax, {200, 2000}}];\
\>", "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"ab13fd66-8b15-4d80-ae8e-cb3be8d2f5cf"],

Cell[CellGroupData[{

Cell["\<\
Grid[Prepend[Flatten[momTable, 1], {\"beta\", \"N\", \"largest relative error \
of E Y_N^r, r = 2..8\"}], Frame -> All]\
\>", "Input",
 CellLabel->"In[55]:=",ExpressionUUID->"4f2f724b-01ba-41e1-bb4d-ac5afba56ccd"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"beta\"\>", "\<\"N\"\>", "\<\"largest relative error of E Y_N^r, r = \
2..8\"\>"},
    {
     FractionBox["1", "4"], "200", "0.003642580836831222`"},
    {

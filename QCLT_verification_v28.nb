Cell[CellGroupData[{

Cell["\<\
check[\"Prop. C: 2 + 1/b > 2 for every b > 0, while 1 < 2/(q-1) <= 2 for 2 <= \
q < 3\",
  Resolve[ForAll[b, b > 0, 2 + 1/b > 2], Reals] && Resolve[ForAll[q, 2 <= q < \
3, 1 < 2/(q - 1) <= 2], Reals]]\
\>", "Input",
 CellLabel->

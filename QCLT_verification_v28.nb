 CellLabel->
  "Out[127]=",ExpressionUUID->"84a6c278-5a25-4c74-b2da-b73261cef933"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Table II: for the skewed noise laws the distance at the first \
checkpoint is at least three times the distance at the last one\",
  And @@ Table[First[sims[cs][\"ks\"]] > 3 Last[sims[cs][\"ks\"]], {cs, \
{{-1/4, \"two\"}, {1/3, \"exp\"}, {1, \"exp\"}}}]]\
\>", "Input",
 CellLabel->
  "In[128]:=",ExpressionUUID->"9d11b137-8db1-4748-9052-e83f3608cbcd"],


}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Table II: the sampling floor is close to the mean 0.8687/Sqrt[M] of \
the Kolmogorov statistic (within 50%)\",
  And @@ (Abs[# Sqrt[mPaths]/0.8687 - 1] < 0.5 & /@ Values[floors])]\
\>", "Input",
 CellLabel->
  "In[129]:=",ExpressionUUID->"bca25a00-ce89-40ef-a338-7b64fb7caf43"],


Cell["\<\
App. C 3: simulation with c_b = 1 + b for b = 5, 20, 50. By Cor. D, proof, \
first fact the limit g_b is Student's law with 1 + 1/b degrees of freedom and \
scale 1; the Cauchy law has scale 1\
\>", "Text",ExpressionUUID->"818ade04-e6c5-4b1b-a024-0be2d219a626"],

Cell["\<\
ksF[y_, cdf_] := With[{f = cdf[Sort[y]], m = Length[y]}, \
Max[Max[Range[m]/N[m] - f], Max[f - (Range[m] - 1)/N[m]]]];\
\>", "Input",
 CellLabel->
  "In[214]:=",ExpressionUUID->"beb2e5a8-0550-4c62-886e-e293341c00f5"],

Cell["\<\
simQ2[b_, kind_] := Module[{s = Sqrt[1. + b] noise[kind, mPaths], bb = N[b], \
ks = {}, y},
   Do[s = s + Sqrt[(1. + bb) + bb s^2/n] noise[kind, mPaths];
    If[MemberQ[{100, 1000, nMax}, n + 1], y = s/Sqrt[n + 1.]; AppendTo[ks, \
ksF[y, tCDF[1. + 1/bb, #] &]]], {n, 1, nMax - 1}];
   y = s/Sqrt[N[nMax]];
   <|\"b\" -> b, \"noise\" -> kind, \"ksG\" -> ks, \"ksC\" -> ksF[y, \
cauchyCDF], \"exact\" -> ksExact[b], \"maxS\" -> Max[Abs[s]], \"finite\" -> \
VectorQ[s, NumericQ], \"final\" -> y|>];\
\>", "Input",
 CellLabel->
  "In[215]:=",ExpressionUUID->"44f9825a-c671-4e78-94d0-5ef75d06e715"],

Cell["\<\
q2cases = {{5, \"gauss\"}, {5, \"rademacher\"}, {20, \"gauss\"}, {20, \
\"rademacher\"}, {50, \"gauss\"}, {50, \"rademacher\"}};\
\>", "Input",
 CellLabel->
  "In[216]:=",ExpressionUUID->"cb1669c5-6391-4e4e-8666-0508ff52826a"],

Cell[CellGroupData[{

Cell["q2Time = First@AbsoluteTiming[q2 = simQ2 @@@ q2cases;]", "Input",
 CellLabel->
  "In[217]:=",ExpressionUUID->"2828b0ca-879b-4a68-995a-9e39bce355eb"],

Cell[BoxData["165.901823`"], "Output",
 CellChangeTimes->{4.00365390861868*^9},
 CellLabel->
  "Out[217]=",ExpressionUUID->"f316a1ba-7c71-46d8-a590-2ee260825f8e"]
}, Open  ]],


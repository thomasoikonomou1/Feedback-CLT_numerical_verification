Cell["\<\
Figure 3: exact distance between g_b and the Cauchy law (line), measured \
distance of S_N/Sqrt[N] to the Cauchy law (points), sampling level \
0.8687/Sqrt[M] (dashed)\
\>", "Text",ExpressionUUID->"5be2de1f-6717-49e4-871f-16f0a37c5d2a"],

Cell[CellGroupData[{

Cell["\<\
fig5 = Show[ListLogLogPlot[Table[{b, ksExact[b]}, {b, 10.^Range[0, 3, \
0.05]}], Joined -> True, PlotStyle -> colA, PlotRange -> {{1, 1000}, {10^-4, \
0.1}}],
   ListLogLogPlot[{Table[{0.94 r[\"b\"], r[\"ksC\"]}, {r, Select[q2, \
#[\"noise\"] == \"gauss\" &]}], Table[{1.06 r[\"b\"], r[\"ksC\"]}, {r, \
Select[q2, #[\"noise\"] == \"rademacher\" &]}]},
    PlotStyle -> {colB, colO}, PlotMarkers -> {Automatic, 9}, PlotLegends -> \
Placed[{\"simulation, Gaussian noise\", \"simulation, noise \[PlusMinus]1\"}, \
{0.7, 0.85}]],
   LogLogPlot[0.8687/Sqrt[mPaths], {x, 1, 1000}, PlotStyle -> Directive[Gray, \
Dashed]],
   Frame -> True, Axes -> False, FrameLabel -> {\"b\", \"Kolmogorov distance \
to the Cauchy law\"}, ImageSize -> 440]\
\>", "Input",
 CellLabel->
  "In[222]:=",ExpressionUUID->"dcce08e6-c062-457b-9449-cb802ec17816"],


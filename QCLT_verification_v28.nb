Cell[CellGroupData[{

Cell["\<\
check[\"Prop. C: g_b(y) |y|^(2+1/b) -> b^(-kappa)/Z_b, so the tail exponent \
is 2 + 1/b (b = 1/3, 1, 2; c = 1)\",
  And @@ Table[close[Limit[(1 + b y^2)^(-kap[b]) y^(2 + 1/b), y -> Infinity], \
b^(-kap[b]), 10^-12], {b, {1/3, 1, 2}}]]\
\>", "Input",
 CellLabel->"In[99]:=",ExpressionUUID->"183991d5-6f76-47b5-833a-796c4f9fc147"],


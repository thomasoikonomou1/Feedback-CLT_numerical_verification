}, Open  ]],

Cell["\<\
Additional table (sample variance): sample variance of S_N/Sqrt[N] and the \
variance c/(1-b) of g_b\
\>", "Text",ExpressionUUID->"1b82e8df-e702-4c57-8d75-9e8e23f74fe6"],

Cell[CellGroupData[{

Cell["\<\
table2 = Grid[Prepend[Table[Join[{cs[[1]], cs[[2]]}, NumberForm[#, {6, 3}] & \
/@ sims[cs][\"var\"], {If[cs[[1]] < 1, N[1/(1 - cs[[1]])], Infinity]}], {cs, \
cases}], Join[{\"b\", \"noise\"}, (\"N = \" <> ToString[#]) & /@ cps, \
{\"c/(1-b)\"}]], Frame -> All, Background -> {None, {1 -> LightGray}}]\
\>", "Input",
 CellLabel->
  "In[130]:=",ExpressionUUID->"27ee7e2d-4e81-4266-a8bb-f25c06c6ac45"],


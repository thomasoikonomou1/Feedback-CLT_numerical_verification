Cell[CellGroupData[{

Cell["\<\
4. Sec. IV and Appendix A: proof of Theorem B (Lemmas 4-6, Eqs. IV.4-IV.7 and \
A.1-A.10)\
\>", "Section",ExpressionUUID->"6fdea929-73ea-48f4-bd79-262833b5200b"],

Cell["Lemma 4: elementary bounds", "Text",ExpressionUUID->"df0ec22f-1e0c-428b-b24b-349ba9249802"],

Cell[CellGroupData[{

Cell["\<\
check[\"Lemma 4(b),(c): sigma' = b y/sigma, sigma'' = b c/sigma^3, sigma''' = \
-3 b c sigma'/sigma^4\",
  Simplify[D[sig[y, b, c], y] == b y/sig[y, b, c]] && Simplify[D[sig[y, b, \
c], {y, 2}] == b c/sig[y, b, c]^3] &&
   Simplify[D[sig[y, b, c], {y, 3}] == -3 b c D[sig[y, b, c], y]/sig[y, b, \
c]^4]]\
\>", "Input",
 CellLabel->"In[60]:=",ExpressionUUID->"162c9542-bc9c-4a87-8546-f211218b5420"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Lemma 4(b),(c): sigma' = b y/sigma, sigma'' = b c/sigma^3, sigma''' = \
-3 b c sigma'/sigma^4\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653236155038*^9},
 CellLabel->"Out[60]=",ExpressionUUID->"75dde775-723c-4b54-bc2d-def6c34c2be7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Lemma 4(d): (y g)' = g (1 - 2 kappa b y^2/D)\",
  Simplify[Expand[D[y (c + b y^2)^(-kap[b]), y] (c + b y^2)^kap[b]] - (1 - 2 \
kap[b] b y^2/(c + b y^2))] === 0]\
\>", "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"9da2cc1b-b4f2-4645-bc9b-a73d3df25d2c"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Lemma 4(d): (y g)' = g (1 - 2 kappa b y^2/D)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653236163628*^9},
 CellLabel->"Out[61]=",ExpressionUUID->"c4f338cf-ae80-416c-996b-aa039d82fb4e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Lemma 4(e): a_1 = Sqrt[c] Gamma(kappa-1) \
Gamma(kappa)/Gamma(kappa-1/2)^2 equals the integral of sigma g (b = 1/3, 1, \
2); a_1 = 3 Pi/8 for b = 1/3 and Pi/2 for b = 1 (c = 1)\",
  And @@ Flatten@Table[close[a1Of[b, c], Quiet@NIntegrate[sig[y, b, c] (c + b \
y^2)^(-kap[b])/zz[b, c], {y, -Infinity, Infinity}], 10^-4], {b, {1/3, 1, 2}}, \
{c, {1, 23/10}}] &&
   close[a1Of[1/3, 1], 3 Pi/8, 10^-12] && close[a1Of[1, 1], Pi/2, 10^-12]]\
\>", "Input",
 CellLabel->"In[62]:=",ExpressionUUID->"9be9aeb9-9521-49e5-a384-51c4e0ecdc9c"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Lemma 4(e): a_1 = Sqrt[c] Gamma(kappa-1) \
Gamma(kappa)/Gamma(kappa-1/2)^2 equals the integral of sigma g (b = 1/3, 1, \
2); a_1 = 3 Pi/8 for b = 1/3 and Pi/2 for b = 1 (c = 1)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.0036532361861258`*^9},
 CellLabel->"Out[62]=",ExpressionUUID->"3898507e-2f16-4f1d-bb8b-2c830d0dce1d"]
}, Open  ]],

Cell["\<\
All pointwise bounds of Lemma 4, of (A.3) and of App. A, bounds, as ratios \
(left side)/(bound) on a grid: b = 1/10..10, c = 1/2..5, t = 0..1/2, s = \
-s0..s0, |y| = 0 and 10^-3..10^3\
\>", "Text",ExpressionUUID->"cbb30b0b-f960-4b44-be67-16539fb76e09"],

Cell["\<\
ratioNames = {\"|sigma'| <= Sqrt[b]\", \"|sigma'''| <= 3 b^(3/2) c/sigma^4\", \
\"|(y g)'| <= 2 kappa g\", \"tau >= 1/2\", \"tau <= 5/4\", \"|tau'| <= \
Sqrt[b] c/(4 sigma^3)\", \"|tau''| <= 3 b c/(4 sigma^4)\",
   \"|U| <= (2/Sqrt[b] + Sqrt[b]) sigma g\", \"|U'| <= (4 kappa + 2 + 4 b) \
g\", \"|(sigma U/tau)'| <= (10 + 11 b + 8 kappa) sigma g\", \"|(P \
sigma'/tau^2)'| <= (4 + 8 b) sigma g\", \"|(sigma y g/tau)'| <= (3 + 4 kappa) \
sigma g\"};\
\>", "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"313e9fdf-fa19-4e5a-8f46-594d7cd57a87"],

Cell["\<\
ratioFun = Module[{kp, dq, sg, g, rho, tau, pp, uu},
   kp = 1 + 1/(2 bv); dq = cv + bv yv^2; sg = Sqrt[dq]; g = dq^(-kp); rho = \
Sqrt[1 - tv^2]; tau = rho + sv D[sg, yv]; pp = dq g; uu = D[pp/tau, yv];
   Function @@ {{yv, sv, tv, bv, cv}, {Abs[D[sg, yv]]/Sqrt[bv], Abs[D[sg, \
{yv, 3}]]/(3 bv^(3/2) cv/sg^4), Abs[D[yv g, yv]]/(2 kp g), 1/(2 tau), 4 \
tau/5,
      Abs[D[tau, yv]]/(Sqrt[bv] cv/(4 sg^3)), Abs[D[tau, {yv, 2}]]/(3 bv \
cv/(4 sg^4)), Abs[uu]/((2/Sqrt[bv] + Sqrt[bv]) sg g), Abs[D[uu, yv]]/((4 kp + \
2 + 4 bv) g),
      Abs[D[sg uu/tau, yv]]/((10 + 11 bv + 8 kp) sg g), Abs[D[pp D[sg, \
yv]/tau^2, yv]]/((4 + 8 bv) sg g), Abs[D[sg yv g/tau, yv]]/((3 + 4 kp) sg \
g)}}];\
\>", "Input",
 CellLabel->"In[64]:=",ExpressionUUID->"a8ac57c7-d349-4562-b968-07d635e03aae"],

Cell["\<\
ratioMax = Max /@ Transpose[Flatten[Table[ratioFun[N[y], N[u/(4 Sqrt[b])], \
N[t], N[b], N[c]],
      {b, {1/10, 1/3, 1, 2, 10}}, {c, {1/2, 1, 5}}, {t, {0, 1/4, 1/2}}, {u, \
{-1, -1/2, 0, 1/2, 1}}, {y, Join[-10^Range[-3, 3, 1/4], {0}, 10^Range[-3, 3, \
1/4]]}], 4]];\
\>", "Input",
 CellLabel->"In[65]:=",ExpressionUUID->"2e019990-6aba-4e44-b4ff-be0b9176d95c"],

Cell[CellGroupData[{

Cell["\<\
Grid[Prepend[Transpose[{ratioNames, ratioMax}], {\"bound\", \"largest ratio \
on the grid\"}], Frame -> All, Alignment -> Left]\
\>", "Input",
 CellLabel->"In[66]:=",ExpressionUUID->"9362d495-0b7e-4335-9fa3-94aeff545828"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"bound\"\>", "\<\"largest ratio on the grid\"\>"},
    {"\<\"|sigma'| <= Sqrt[b]\"\>", "0.999999975000001`"},
    {"\<\"|sigma'''| <= 3 b^(3/2) c/sigma^4\"\>", "0.9999999817927565`"},
    {"\<\"|(y g)'| <= 2 kappa g\"\>", "0.9166616666916667`"},
    {"\<\"tau >= 1/2\"\>", "0.8116548308811612`"},
    {"\<\"tau <= 5/4\"\>", "0.9999999950000004`"},
    {"\<\"|tau'| <= Sqrt[b] c/(4 sigma^3)\"\>", "1.0000000008349066`"},
    {"\<\"|tau''| <= 3 b c/(4 sigma^4)\"\>", "0.9999999795606286`"},
    {"\<\"|U| <= (2/Sqrt[b] + Sqrt[b]) sigma g\"\>", "0.7730017350649906`"},
    {"\<\"|U'| <= (4 kappa + 2 + 4 b) g\"\>", "0.6763743700816836`"},
    {"\<\"|(sigma U/tau)'| <= (10 + 11 b + 8 kappa) sigma g\"\>", 
     "0.4458735634935204`"},
    {"\<\"|(P sigma'/tau^2)'| <= (4 + 8 b) sigma g\"\>", 
     "0.5489819587261396`"},
    {"\<\"|(sigma y g/tau)'| <= (3 + 4 kappa) sigma g\"\>", 
     "0.6012217680528268`"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{4.003653239735746*^9},
 CellLabel->"Out[66]=",ExpressionUUID->"2c875ba1-a1e3-4b8c-9084-303a1083ce70"]
}, Open  ]],


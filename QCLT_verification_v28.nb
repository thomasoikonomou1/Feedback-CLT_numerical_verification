}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Sec. III, moments of the normalized sum: u_n (1 - a/n) = 1 - \
lambda_r/n + [r a/(2 n^2) + omega_n (1 - a/n)], with u_n = 1 - r/(2n) + \
omega_n and lambda_r = r/2 + a\",
  Expand[(1 - r/(2 n) + th) (1 - a/n) - (1 - (r/2 + a)/n + (r a/(2 n^2) + th \
(1 - a/n)))] === 0]\
\>", "Input",
 CellLabel->"In[38]:=",ExpressionUUID->"d3cf1d81-744c-4aa6-b4c0-81c8020d98ca"],

Cell[BoxData[
 TemplateBox[{

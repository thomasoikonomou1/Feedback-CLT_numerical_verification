Cell["\<\
Cor. D, proof, (d): the bound (V.4). Lambda multiplies both sides and is left \
out\
\>", "Text",ExpressionUUID->"890ff2e3-fb0e-4dba-a265-f384a78d9868"],

Cell[CellGroupData[{

Cell["\<\
check[\"(V.4): Sqrt[3/N] 9 b Sqrt[c_b] + 161 M3 b^2 Sqrt[c_b] ln(N/3)/Sqrt[N] \

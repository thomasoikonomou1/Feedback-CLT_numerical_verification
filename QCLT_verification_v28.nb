Cell["\<\
check[\"Additional table (one-step defect) and Additional figure (one-step \
defect): the values of W1(g K^eps, g) agree with those obtained with the \
Python scripts of the manuscript within 1%\",
  And @@ Table[With[{r = SelectFirst[defTab, #[\"b\"] == ref[[1]] && \
#[\"noise\"] == ref[[2]] &]}, Abs[r[\"w1\"][[Position[r[\"eps\"], \
ref[[3]]][[1, 1]]]]/ref[[4]] - 1] < 0.01], {ref, defRef}]]\

Cell["Sec. III: Lemma 2", "Text",ExpressionUUID->"c7436aab-ad44-4cdf-893b-f1de1cc5809b"],

Cell["pProd[lam_, n_, nN_] := Product[1 - lam/k, {k, n, nN - 1}];", "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"a9b960cf-9562-48d7-a1e8-4e4e069c55e3"],

Cell[CellGroupData[{

Cell["\<\
check[\"Lemma 2: the sum of (lambda/n) P_(n+1,N) telescopes to 1 - P_(n1,N) \
(exact; lambda = 7/4, n1 = 3, N = 5..60)\",
  And @@ Table[Sum[(7/4)/n pProd[7/4, n + 1, nN], {n, 3, nN - 1}] == 1 - \
pProd[7/4, 3, nN], {nN, 5, 60}]]\
\>", "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"4ef3f522-c185-44cd-8ef5-894f5e9f92c3"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Lemma 2: the sum of (lambda/n) P_(n+1,N) telescopes to 1 - P_(n1,N) \
(exact; lambda = 7/4, n1 = 3, N = 5..60)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653233772831*^9},
 CellLabel->"Out[43]=",ExpressionUUID->"799fbb60-62bb-45c0-8fef-50e388c5040c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Lemma 2: P_(n1,N) <= exp(-lambda (1/n1 + ... + 1/(N-1))), which tends \
to 0\",
  And @@ Table[N[pProd[7/4, 3, nN]] <= N[Exp[-7/4 (HarmonicNumber[nN - 1] - \
HarmonicNumber[2])]], {nN, 5, 400, 5}]]\
\>", "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"a888de53-1709-4419-8b02-5397bfbee0dd"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Lemma 2: P_(n1,N) <= exp(-lambda (1/n1 + ... + 1/(N-1))), which tends \
to 0\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653233814114*^9},
 CellLabel->"Out[44]=",ExpressionUUID->"25aaf0f0-c707-4ea8-a817-d4a0d8a0e4d9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
lemma2Demo = Module[{x = 5., lam = 1.7, z = 2.}, Do[x = (1 - lam/n) x + lam/n \
(z + 1./n) + (-1)^n/n^1.5, {n, 1, 200000}]; x]\
\>", "Input",

Cell[CellGroupData[{

Cell["\<\
9. Corollary D: the Cauchy law, q = 2 (Sec. V B, Appendix C 3, Table III, \
Figure 3)\
\>", "Section",ExpressionUUID->"453577c0-ebe5-4167-8502-e9b01202bb01"],

Cell["\<\
The four facts and the final step of the proof of Corollary D, the two \
remarks after it, the simulation of Appendix C 3 (six runs with the \
parameters of Section 6, about half the time of Section 6), and panel (j) of \
Figure 1 (q = 2).\
\>", "Text",ExpressionUUID->"36119603-9246-41e1-b9b5-a1c018504e1e"],

Cell["\<\
Cor. D, proof, first fact: with c_b = c (1 + b), the limit law g_b is \
Student's law with nu = 1 + 1/b degrees of freedom and scale Sqrt[c], for \
every b\
\>", "Text",ExpressionUUID->"c4cba173-6ccc-4fe1-a65e-c695a42a4585"],

Cell[CellGroupData[{

Cell["\<\
check[\"Cor. D, proof, first fact: with c_b = c(1+b), g_b is the law of \
Sqrt[c] T_nu, nu = 1 + 1/b (b = 1, 5, 50; c = 1, 23/10)\",
  And @@ Flatten@Table[close[gb[y, b, c (1 + b)], PDF[StudentTDistribution[0, \
Sqrt[c], 1 + 1/b], y], 10^-10], {b, {1, 5, 50}}, {c, {1, 23/10}}, {y, {-7/2, \
0, 1/3, 5}}]]\
\>", "Input",
 CellLabel->
  "In[186]:=",ExpressionUUID->"83b0a0f8-8b55-433a-8607-09d928115f97"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Cor. D, proof, first fact: with c_b = c(1+b), g_b is the law of Sqrt[c] \
T_nu, nu = 1 + 1/b (b = 1, 5, 50; c = 1, 23/10)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.00365374188538*^9},
 CellLabel->
  "Out[186]=",ExpressionUUID->"e54ba04f-891e-4fe7-8564-f645243ed11c"]
}, Open  ]],

Cell["\<\
Cor. D, proof, second fact: the Student density at nu = 1 is the Cauchy \
density, and the L1 distance of the densities tends to 0 as b -> Infinity\
\>", "Text",ExpressionUUID->"5146a4b2-b562-40ff-9b35-eeb06639ebad"],

Cell[CellGroupData[{

Cell["\<\
check[\"Cor. D, proof, second fact: the Student density with nu = 1 is the \
Cauchy density 1/(Pi(1+t^2))\", FullSimplify[PDF[StudentTDistribution[1], t] \
- 1/(Pi (1 + t^2))] === 0]\
\>", "Input",
 CellLabel->
  "In[187]:=",ExpressionUUID->"a0635b81-8c29-4124-8e64-d297e3eb2486"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Cor. D, proof, second fact: the Student density with nu = 1 is the \
Cauchy density 1/(Pi(1+t^2))\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.00365374190246*^9},
 CellLabel->
  "Out[187]=",ExpressionUUID->"0f58120e-ed0f-4056-8ce4-882c8b4f81b9"]
}, Open  ]],

Cell["\<\
l1Dist[b_] := 2 NIntegrate[Abs[PDF[StudentTDistribution[1 + 1/b], t] - 1/(Pi \
(1 + t^2))], {t, 0, 1, 10, 100, 10^4, Infinity}, MaxRecursion -> 50, \
PrecisionGoal -> 6];\
\>", "Input",
 CellLabel->
  "In[188]:=",ExpressionUUID->"a08a6d03-8a41-421e-aa37-55ebc4d86c66"],

Cell[CellGroupData[{

Cell["\<\
l1Tab = Table[{b, Quiet@l1Dist[N[b]]}, {b, {5, 20, 50, 200, 1000}}]\
\>", "Input",
 CellLabel->
  "In[189]:=",ExpressionUUID->"84763932-1361-42b2-9c6b-0a5a141ded8b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5", ",", "0.069692717032787`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"20", ",", "0.019377543300450238`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"50", ",", "0.007928516329749611`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"200", ",", "0.002005074804402129`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1000", ",", "0.00040225643972801396`"}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{4.003653741959919*^9},
 CellLabel->
  "Out[189]=",ExpressionUUID->"4d93f2eb-348d-49d0-8d28-151b7de2963a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Cor. D, proof, second fact: the L1 distance between f_nu and f_1 \
decreases in b and is below 0.41/b (b = 5, 20, 50, 200, 1000)\",
  And @@ (Greater @@@ Partition[l1Tab[[All, 2]], 2, 1]) && And @@ (#[[1]] \
#[[2]] < 0.41 & /@ l1Tab)]\
\>", "Input",
 CellLabel->
  "In[190]:=",ExpressionUUID->"cc9c8543-bf21-4a2b-8a04-8cafa0cfaec2"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Cor. D, proof, second fact: the L1 distance between f_nu and f_1 \
decreases in b and is below 0.41/b (b = 5, 20, 50, 200, 1000)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.0036537419759274`*^9},
 CellLabel->
  "Out[190]=",ExpressionUUID->"db296cfa-cdce-4a32-bb06-7a6934042185"]
}, Open  ]],

Cell["\<\
Exact Kolmogorov distance between g_b (scale 1) and the standard Cauchy law, \
by maximizing over a fine logarithmic grid\
\>", "Text",ExpressionUUID->"d84fc733-ead0-4468-9bfe-79e3548a3bb6"],

Cell["\<\
tCDF[nu_, y_] := 0.5 + Sign[y] (1 - BetaRegularized[nu/(nu + y^2), nu/2, \
0.5])/2;\
\>", "Input",
 CellLabel->
  "In[191]:=",ExpressionUUID->"166d71d1-98d7-452a-bbe6-cbe4e9868984"],

Cell["cauchyCDF[y_] := 0.5 + ArcTan[y]/Pi;", "Input",
 CellLabel->
  "In[192]:=",ExpressionUUID->"1b52ec64-a8ea-4548-a2a9-c9245cab8de7"],

Cell["\<\
ksExact[b_] := With[{ts = 10.^Range[-4., 7., 0.0005]}, Max[Abs[tCDF[1. + 1/b, \
ts] - cauchyCDF[ts]]]];\
\>", "Input",
 CellLabel->
  "In[193]:=",ExpressionUUID->"cc177fd4-4270-4c59-864b-d03b25b2299a"],

Cell[CellGroupData[{

Cell["\<\
check[\"App. C 3: the exact Kolmogorov distance between g_b and the Cauchy \
law is 0.01742, 0.00484, 0.00198 for b = 5, 20, 50, and about 0.1/b for large \
b\",
  Abs[ksExact[5] - 0.017423] < 2 10^-5 && Abs[ksExact[20] - 0.004844] < 2 \
10^-5 && Abs[ksExact[50] - 0.001982] < 2 10^-5 && Abs[1000 ksExact[1000] - \
0.1006] < 0.002]\
\>", "Input",
 CellLabel->
  "In[194]:=",ExpressionUUID->"1d2203e4-d832-40c4-9a2b-fbff5fcdec3b"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"App. C 3: the exact Kolmogorov distance between g_b and the Cauchy law \
is 0.01742, 0.00484, 0.00198 for b = 5, 20, 50, and about 0.1/b for large \
b\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.0036537421831627`*^9},
 CellLabel->
  "Out[194]=",ExpressionUUID->"5c2f9b07-7d02-4181-9473-6fa5d7e0e966"]
}, Open  ]],

Cell["\<\
Cor. D, proof, (a): the Beta integral (V.3) and the bound on a_1\
\>", "Text",ExpressionUUID->"116a5658-adc4-4990-aaba-d4e9c51e2b75"],

Cell[CellGroupData[{

Cell["\<\
check[\"(V.3): Int (c + b y^2)^(-s) dy = c^(1/2-s) Sqrt[Pi/b] \
Gamma[s-1/2]/Gamma[s] (numerical; s = 3/4, 1, 3/2, 3; b = 1/2, 2, 50; c = 1, \
23/5)\",
  And @@ Flatten@Table[close[Quiet@NIntegrate[(c + b y^2)^(-s), {y, \
-Infinity, Infinity}, MaxRecursion -> 50], c^(1/2 - s) Sqrt[Pi/b] Gamma[s - \
1/2]/Gamma[s], 10^-5], {s, {3/4, 1, 3/2, 3}}, {b, {1/2, 2, 50}}, {c, {1, \
23/5}}]]\
\>", "Input",
 CellLabel->
  "In[195]:=",ExpressionUUID->"3505e7b2-fad4-4875-b7f4-ce9546cc8b59"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"(V.3): Int (c + b y^2)^(-s) dy = c^(1/2-s) Sqrt[Pi/b] \
Gamma[s-1/2]/Gamma[s] (numerical; s = 3/4, 1, 3/2, 3; b = 1/2, 2, 50; c = 1, \
23/5)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.003653742283132*^9},
 CellLabel->
  "Out[195]=",ExpressionUUID->"a828f4a5-9cdc-4611-ba45-e28abca64628"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Cor. D, proof, (a): (V.3) with s = kappa - 1/2 divided by (V.3) with \
s = kappa gives a_1 = Sqrt[c] Gamma[kappa-1] Gamma[kappa]/Gamma[kappa-1/2]^2\",
  FullSimplify[(c^(1/2 - (k - 1/2)) Sqrt[Pi/b] Gamma[k - 1]/Gamma[k - \
1/2])/(c^(1/2 - k) Sqrt[Pi/b] Gamma[k - 1/2]/Gamma[k]) == Sqrt[c] Gamma[k - \
1] Gamma[k]/Gamma[k - 1/2]^2, {c > 0, b > 0, k > 1}]]\
\>", "Input",
 CellLabel->
  "In[196]:=",ExpressionUUID->"8c37ce2b-974e-420a-ac51-3fdccaf0a146"],


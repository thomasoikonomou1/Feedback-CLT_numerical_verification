Cell["\<\
Cor. D, proof, (c): E|Y_3| computed exactly by enumerating all noise values \
of the first three steps\
\>", "Text",ExpressionUUID->"57605cf5-2a88-4bb7-8246-3a1a7f7308fb"],

Cell["\<\
eY3[b_, cb_, at_] := Total[Function[p, Module[{y = Sqrt[cb] p[[1, 1]]}, Do[y \
= Sqrt[n/(n + 1)] y + 1/Sqrt[n + 1] Sqrt[cb + b y^2] p[[n + 1, 1]], {n, 1, \
2}]; Abs[y] Times @@ p[[All, 2]]]] /@ Tuples[at, 3]];\
\>", "Input",
 CellLabel->
  "In[200]:=",ExpressionUUID->"361ad7e8-2487-49ae-85a2-2738661d724d"],

Cell[CellGroupData[{

Cell["\<\
check[\"Cor. D, proof, (c): E|Y_3| <= (3 + 3 Sqrt[b] + b) Sqrt[c_b], exact \
for noise +1/-1, three-point and skewed two-point (b = 1, 2, 5, 50, 1000; c = \
1, 23/10)\",
  And @@ Flatten@Table[N[eY3[b, c (1 + b), atoms[k]]] <= N[(3 + 3 Sqrt[b] + \
b) Sqrt[c (1 + b)]], {k, {\"rademacher\", \"three\", \"two\"}}, {b, {1, 2, 5, \
50, 1000}}, {c, {1, 23/10}}]]\
\>", "Input",
 CellLabel->
  "In[201]:=",ExpressionUUID->"872024fa-1ada-4795-be72-79cc7ef8a30c"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
    RGBColor[0, 
     Rational[2, 3], 0], StripOnInput -> False], "\"   \"", 
   "\"Cor. D, proof, (c): E|Y_3| <= (3 + 3 Sqrt[b] + b) Sqrt[c_b], exact for \
noise +1/-1, three-point and skewed two-point (b = 1, 2, 5, 50, 1000; c = 1, \
23/10)\""},
  "RowDefault"]], "Output",
 CellChangeTimes->{4.0036537424417067`*^9},
 CellLabel->
  "Out[201]=",ExpressionUUID->"e58683df-00ec-4c40-8469-d005008c8b79"]
}, Open  ]],

Cell["\<\
eAbsG[b_, c_] := Sqrt[c] 2 Sqrt[1 + 1/b] Gamma[(2 + 1/b)/2]/(Sqrt[Pi] (1/b) \
Gamma[(1 + 1/b)/2]);\
\>", "Input",
 CellLabel->
  "In[202]:=",ExpressionUUID->"f6831033-c4a9-42ce-941c-1859dda9a586"],

Cell[CellGroupData[{

Cell["\<\
check[\"Cor. D, proof, (c): E_g|Y| = 2 Sqrt[c nu] Gamma((nu+1)/2)/(Sqrt[Pi] \
(nu-1) Gamma(nu/2)) for the law Sqrt[c] T_nu (numerical check, b = 1, 3, \
5)\",
  And @@ Table[close[eAbsG[b, 1], Quiet@NIntegrate[2 y \
PDF[StudentTDistribution[1 + 1/b], y], {y, 0, 1, 100, Infinity}, MaxRecursion \
-> 50], 10^-4], {b, {1, 3, 5}}]]\

Cell["Sec. III, moments of the sum: the moment recursion (III.2)", "Text",ExpressionUUID->"9233dc5a-049e-4ac6-89ff-0d5bf3e52076"],

Cell[CellGroupData[{

Cell["\<\
check[\"(III.2): the terms j = 0 and j = 2 of the binomial expansion, with \
E[X^2 | F] = c - beta S^2/n (r = 2..8)\",
  And @@ Table[Expand[s^r + Binomial[r, 2] s^(r - 2) (c - be s^2/n) - ((1 - \
Binomial[r, 2] be/n) s^r + Binomial[r, 2] c s^(r - 2))] === 0, {r, 2, 8}]]\
\>", "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"2447d7a1-0270-4b00-91f9-2ea93f89ad74"],

Cell[BoxData[

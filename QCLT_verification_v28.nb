  "Out[211]=",ExpressionUUID->"42b72cca-e521-4dd8-88c6-9634b056bcfc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
check[\"Remark (an equivalent form): (1 + b)(c + b u^2/n) = c(1 + b) + b \
(Sqrt[1+b] u)^2/n, so Sqrt[1+b] U_n follows the recursion with c_N = \
c(1+b)\",
  Simplify[(1 + b) (c + b u^2/n) == c (1 + b) + b (Sqrt[1 + b] u)^2/n]]\
\>", "Input",
 CellLabel->
  "In[212]:=",ExpressionUUID->"d7b9aca6-9937-477e-9e4c-dc45a48b9dae"],


          FontColor->RGBColor[0, 
            Rational[2, 3], 0]]},
        {"117", "\<\"Prop. E (i): (B.2) applied to g_b gives D = c + b y^2 (b \
= 1/3, 1, 2, -1/4, -1/2, -1; c = 1, 23/10; y = 0, 1/2, 3, 20 for b > 0 and y \
= 0, L/3, 2L/3 for b < 0)\"\>", 
         StyleBox["\<\"PASS\"\>",
          StripOnInput->False,
          LineColor->RGBColor[0, 
            Rational[2, 3], 0],
          FrontFaceColor->RGBColor[0, 
            Rational[2, 3], 0],
          BackFaceColor->RGBColor[0, 

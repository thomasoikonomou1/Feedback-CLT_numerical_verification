Cell[CellGroupData[{

Cell["\<\
check[\"Cor. D, proof, final step: (theta ln N)^(5/3) (1 + ln N) N^(chi - \
1/2) -> 0 when chi < 1/2 (theta = 1/20, chi = 49/100)\",
  Limit[(Log[nn]/20)^(5/3) (1 + Log[nn]) nn^(49/100 - 1/2), nn -> Infinity] \
== 0]\
\>", "Input",
 CellLabel->
  "In[210]:=",ExpressionUUID->"42eba4f1-824a-48b2-804d-76267028ce02"],

Cell[BoxData[
 TemplateBox[{
   StyleBox["\"PASS\"", Bold, 
